<Window x:Class="ClinicStatisticsApp.UI.SummaryAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Статистика по администраторам"
        Height="850"
        Width="1200"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Год:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="YearComboBox" Width="100" Margin="0,0,20,0"/>

            <TextBlock Text="Месяц:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="MonthComboBox" Width="140" Margin="0,0,20,0"/>

            <Button Content="Построить" Width="140" Height="34" Click="BuildButton_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="ПО ФИЛИАЛАМ"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <DataGrid x:Name="BranchAdminsDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Margin="0,0,0,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Филиал" Binding="{Binding BranchName}" Width="150"/>
                        <DataGridTextColumn Header="Администратор" Binding="{Binding EmployeeFullName}" Width="220"/>
                        <DataGridTextColumn Header="Явка" Binding="{Binding AttendanceCount}" Width="100"/>
                        <DataGridTextColumn Header="Неявка" Binding="{Binding AbsenceCount}" Width="100"/>
                        <DataGridTextColumn Header="Премия" Binding="{Binding Premium}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="BranchTotalsTextBlock"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,20"/>

                <TextBlock Text="КОЛЛ-ЦЕНТР"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <DataGrid x:Name="CallCenterDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Margin="0,0,0,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Филиал" Binding="{Binding BranchName}" Width="150"/>
                        <DataGridTextColumn Header="Оператор" Binding="{Binding EmployeeFullName}" Width="220"/>
                        <DataGridTextColumn Header="Явка" Binding="{Binding AttendanceCount}" Width="100"/>
                        <DataGridTextColumn Header="Неявка" Binding="{Binding AbsenceCount}" Width="100"/>
                        <DataGridTextColumn Header="Премия" Binding="{Binding Premium}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="CallCenterTotalsTextBlock"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,20"/>

                <TextBlock x:Name="SystemTotalsTextBlock"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#1E4E8C"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>