<Window x:Class="ClinicStatisticsApp.UI.SummaryAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Статистика по администраторам"
        Height="940"
        Width="1320"
        MinHeight="900"
        MinWidth="1200"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Статистика по администраторам"
                               Style="{StaticResource TitleTextStyle}"/>

                    <TextBlock Text="Сводный отчет по администраторам филиалов и колл-центра за выбранный период."
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource PrimaryLightBrush}"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,8"
                        VerticalAlignment="Top">
                    <TextBlock Text="Сводная аналитика"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- Параметры -->
        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Параметры построения"
                           Style="{StaticResource SectionTextStyle}"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Год"/>
                        <ComboBox x:Name="YearComboBox"
                                  Width="160"
                                  Height="40"
                                  Style="{StaticResource ModernComboBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="Месяц"/>
                        <ComboBox x:Name="MonthComboBox"
                                  Width="160"
                                  Height="40"
                                  Style="{StaticResource ModernComboBoxStyle}"/>
                    </StackPanel>

                    <Button Grid.Column="4"
                            Content="Построить"
                            Width="140"
                            Height="42"
                            Margin="0,30,0,0"
                            Click="BuildButton_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Контент -->
        <Border Grid.Row="4"
                Style="{StaticResource CardBorderStyle}"
                Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- По филиалам -->
                    <TextBlock Text="ПО ФИЛИАЛАМ"
                               Style="{StaticResource SectionTextStyle}"
                               FontSize="20"
                               Margin="0,0,0,12"/>

                    <DataGrid x:Name="BranchAdminsDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Филиал" Binding="{Binding BranchName}" Width="180"/>
                            <DataGridTextColumn Header="Администратор" Binding="{Binding EmployeeFullName}" Width="260"/>
                            <DataGridTextColumn Header="Явка" Binding="{Binding AttendanceCount}" Width="120"/>
                            <DataGridTextColumn Header="Неявка" Binding="{Binding AbsenceCount}" Width="120"/>
                            <DataGridTextColumn Header="Премия" Binding="{Binding Premium}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Background="{StaticResource MutedBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrushCustom}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,0,22">
                        <TextBlock x:Name="BranchTotalsTextBlock"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Колл-центр -->
                    <TextBlock Text="КОЛЛ-ЦЕНТР"
                               Style="{StaticResource SectionTextStyle}"
                               FontSize="20"
                               Margin="0,0,0,12"/>

                    <DataGrid x:Name="CallCenterDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Филиал" Binding="{Binding BranchName}" Width="180"/>
                            <DataGridTextColumn Header="Оператор" Binding="{Binding EmployeeFullName}" Width="260"/>
                            <DataGridTextColumn Header="Явка" Binding="{Binding AttendanceCount}" Width="120"/>
                            <DataGridTextColumn Header="Неявка" Binding="{Binding AbsenceCount}" Width="120"/>
                            <DataGridTextColumn Header="Премия" Binding="{Binding Premium}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Background="{StaticResource MutedBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrushCustom}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,0,22">
                        <TextBlock x:Name="CallCenterTotalsTextBlock"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Общий итог -->
                    <Border Background="{StaticResource PrimaryLightBrush}"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16">
                        <TextBlock x:Name="SystemTotalsTextBlock"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>