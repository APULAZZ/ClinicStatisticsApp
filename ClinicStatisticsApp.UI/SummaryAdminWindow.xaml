<Window x:Class="ClinicStatisticsApp.UI.SummaryAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Статистика по администраторам"
        Height="860"
        Width="1320"
        MinHeight="840"
        MinWidth="1200"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackgroundSoftBrush}">

    <Window.Resources>
        <Style x:Key="CenteredCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LeftCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="10"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="← Назад"
                        Width="82"
                        Height="30"
                        Margin="0"
                        FontSize="11"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BackButton_Click"/>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Статистика по администраторам"
                               Style="{StaticResource TitleTextStyle}"
                               FontSize="18"/>

                    <TextBlock Text="Сводка по администраторам филиалов и колл-центра."
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,2,0,0"
                               FontSize="11"/>
                </StackPanel>

                <Border Grid.Column="3"
                        Background="{StaticResource SubtleAccentBrush}"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,4"
                        VerticalAlignment="Top">
                    <TextBlock Text="Сводная аналитика"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}"
                Padding="10"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Label Content="Год"/>
                    <ComboBox x:Name="YearComboBox"
                              Width="130"
                              Height="30"
                              FontSize="12"
                              Style="{StaticResource ModernComboBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Label Content="Месяц"/>
                    <ComboBox x:Name="MonthComboBox"
                              Width="130"
                              Height="30"
                              FontSize="12"
                              Style="{StaticResource ModernComboBoxStyle}"/>
                </StackPanel>

                <Button Grid.Column="4"
                        Content="Построить"
                        Width="110"
                        Height="32"
                        Margin="0,24,0,0"
                        FontSize="12"
                        Click="BuildButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Style="{StaticResource CardBorderStyle}"
                Padding="8"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <TextBlock Text="ПО ФИЛИАЛАМ"
                               Style="{StaticResource SectionTextStyle}"
                               FontSize="17"
                               Margin="0,0,0,8"/>

                    <DataGrid x:Name="BranchAdminsDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Margin="0,0,0,8"
                              RowHeight="26"
                              ColumnHeaderHeight="34"
                              FontSize="12"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#E5E7EB"
                              VerticalGridLinesBrush="#E5E7EB">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="6,2"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>

                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Padding" Value="8,5"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Height" Value="34"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Филиал"
                                                Binding="{Binding BranchName}"
                                                Width="160"
                                                ElementStyle="{StaticResource LeftCellStyle}"/>

                            <DataGridTextColumn Header="Администратор"
                                                Binding="{Binding EmployeeFullName}"
                                                Width="240"
                                                ElementStyle="{StaticResource LeftCellStyle}"/>

                            <DataGridTextColumn Header="Явка"
                                                Binding="{Binding AttendanceCount}"
                                                Width="90"
                                                ElementStyle="{StaticResource CenteredCellStyle}"/>

                            <DataGridTextColumn Header="Неявка"
                                                Binding="{Binding AbsenceCount}"
                                                Width="90"
                                                ElementStyle="{StaticResource CenteredCellStyle}"/>

                            <DataGridTextColumn Header="Премия"
                                                Binding="{Binding Premium}"
                                                Width="110"
                                                ElementStyle="{StaticResource CenteredCellStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource SoftBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10"
                            Margin="0,0,0,14">
                        <TextBlock x:Name="BranchTotalsTextBlock"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="КОЛЛ-ЦЕНТР"
                               Style="{StaticResource SectionTextStyle}"
                               FontSize="17"
                               Margin="0,0,0,8"/>

                    <DataGrid x:Name="CallCenterDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Margin="0,0,0,8"
                              RowHeight="26"
                              ColumnHeaderHeight="34"
                              FontSize="12"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#E5E7EB"
                              VerticalGridLinesBrush="#E5E7EB">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="6,2"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>

                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Padding" Value="8,5"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Height" Value="34"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Филиал"
                                                Binding="{Binding BranchName}"
                                                Width="160"
                                                ElementStyle="{StaticResource LeftCellStyle}"/>

                            <DataGridTextColumn Header="Оператор"
                                                Binding="{Binding EmployeeFullName}"
                                                Width="240"
                                                ElementStyle="{StaticResource LeftCellStyle}"/>

                            <DataGridTextColumn Header="Явка"
                                                Binding="{Binding AttendanceCount}"
                                                Width="90"
                                                ElementStyle="{StaticResource CenteredCellStyle}"/>

                            <DataGridTextColumn Header="Неявка"
                                                Binding="{Binding AbsenceCount}"
                                                Width="90"
                                                ElementStyle="{StaticResource CenteredCellStyle}"/>

                            <DataGridTextColumn Header="Премия"
                                                Binding="{Binding Premium}"
                                                Width="110"
                                                ElementStyle="{StaticResource CenteredCellStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource SoftBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10"
                            Margin="0,0,0,14">
                        <TextBlock x:Name="CallCenterTotalsTextBlock"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Border Background="{StaticResource SubtleAccentBrush}"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12">
                        <TextBlock x:Name="SystemTotalsTextBlock"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>