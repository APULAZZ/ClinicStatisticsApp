<Window x:Class="ClinicStatisticsApp.UI.UsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пользователи"
        Height="650"
        Width="1050"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button Content="Добавить" Width="120" Height="36" Margin="0,0,10,0" Click="AddButton_Click"/>
            <Button Content="Редактировать" Width="140" Height="36" Margin="0,0,10,0" Click="EditButton_Click"/>
            <Button Content="Включить" Width="120" Height="36" Margin="0,0,10,0" Click="EnableButton_Click"/>
            <Button Content="Отключить" Width="120" Height="36" Margin="0,0,10,0" Click="DisableButton_Click"/>
            <Button Content="Удалить" Width="120" Height="36" Margin="0,0,10,0" Click="DeleteButton_Click"/>
            <Button Content="Обновить" Width="120" Height="36" Click="RefreshButton_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="2"
                  x:Name="UsersDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="120"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="220"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role.Name}" Width="150"/>
                <DataGridTextColumn Header="Филиал" Binding="{Binding Branch.Name}" Width="150"/>
                <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>