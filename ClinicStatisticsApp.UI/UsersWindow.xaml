<UserControl x:Class="ClinicStatisticsApp.UI.UsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource PageBackgroundSoftBrush}">

    <UserControl.Resources>
        <Style x:Key="CenteredCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LeftCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="10"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Управление пользователями"
                               Style="{StaticResource TitleTextStyle}"
                               FontSize="18"/>

                    <TextBlock Text="Учетные записи, роли, филиалы и статус активности."
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,2,0,0"
                               FontSize="11"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource SubtleAccentBrush}"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,4"
                        VerticalAlignment="Top">
                    <TextBlock Text="Администрирование"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- Действия -->
        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}"
                Padding="10"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Добавить"
                        Width="90"
                        Height="32"
                        Margin="0"
                        FontSize="12"
                        Click="AddButton_Click"/>

                <Button Grid.Column="2"
                        Content="Редактировать"
                        Width="110"
                        Height="32"
                        Margin="0"
                        FontSize="12"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="EditButton_Click"/>

                <Button Grid.Column="4"
                        Content="Включить"
                        Width="90"
                        Height="32"
                        Margin="0"
                        FontSize="12"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="EnableButton_Click"/>

                <Button Grid.Column="6"
                        Content="Отключить"
                        Width="95"
                        Height="32"
                        Margin="0"
                        FontSize="12"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="DisableButton_Click"/>

                <Button Grid.Column="8"
                        Content="Удалить"
                        Width="90"
                        Height="32"
                        Margin="0"
                        FontSize="12"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="DeleteButton_Click"/>

                <Button Grid.Column="10"
                        Content="Обновить"
                        Width="95"
                        Height="32"
                        Margin="0"
                        FontSize="12"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="RefreshButton_Click"/>
            </Grid>
        </Border>

        <!-- Таблица -->
        <Border Grid.Row="4"
                Style="{StaticResource CardBorderStyle}"
                Padding="8"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}">
            <DataGrid x:Name="UsersDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      RowHeight="26"
                      ColumnHeaderHeight="30"
                      FontSize="12"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#E5E7EB"
                      VerticalGridLinesBrush="#E5E7EB">
                <DataGrid.Resources>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="6,2"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>

                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Height" Value="30"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="BorderBrush" Value="#D1D5DB"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding Id}"
                                        Width="55"
                                        ElementStyle="{StaticResource CenteredCellStyle}"/>

                    <DataGridTextColumn Header="Логин"
                                        Binding="{Binding Login}"
                                        Width="130"
                                        ElementStyle="{StaticResource LeftCellStyle}"/>

                    <DataGridTextColumn Header="ФИО"
                                        Binding="{Binding FullName}"
                                        Width="240"
                                        ElementStyle="{StaticResource LeftCellStyle}"/>

                    <DataGridTextColumn Header="Роль"
                                        Binding="{Binding Role.Name}"
                                        Width="170"
                                        ElementStyle="{StaticResource LeftCellStyle}"/>

                    <DataGridTextColumn Header="Филиал"
                                        Binding="{Binding Branch.Name}"
                                        Width="170"
                                        ElementStyle="{StaticResource LeftCellStyle}"/>

                    <DataGridCheckBoxColumn Header="Активен"
                                            Binding="{Binding IsActive}"
                                            Width="85"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
