<Window x:Class="ClinicStatisticsApp.UI.EmployeesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудники"
        Height="740"
        Width="1120"
        MinHeight="740"
        MinWidth="1120"
        WindowStartupLocation="CenterOwner">

	<Grid Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="18"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="18"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Шапка -->
		<Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<StackPanel>
					<TextBlock Text="Управление сотрудниками"
                               Style="{StaticResource TitleTextStyle}"/>

					<TextBlock Text="Просмотр и редактирование карточек сотрудников, статуса активности и параметров мотивации."
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,8,0,0"/>
				</StackPanel>

				<Border Grid.Column="1"
                        Background="{StaticResource PrimaryLightBrush}"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,8"
                        VerticalAlignment="Top">
					<TextBlock Text="Справочник сотрудников"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"/>
				</Border>
			</Grid>
		</Border>

		<!-- Действия -->
		<Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="18"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<TextBlock Text="Действия"
                           Style="{StaticResource SectionTextStyle}"/>

				<WrapPanel Grid.Row="2">
					<Button Content="Добавить"
                            Width="130"
                            Height="42"
                            Margin="0,0,10,0"
                            Click="AddButton_Click"/>

					<Button Content="Редактировать"
                            Width="150"
                            Height="42"
                            Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="EditButton_Click"/>

					<Button Content="Обновить"
                            Width="130"
                            Height="42"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="RefreshButton_Click"/>
				</WrapPanel>
			</Grid>
		</Border>

		<!-- Таблица -->
		<Border Grid.Row="4"
                Style="{StaticResource CardBorderStyle}"
                Padding="18">
			<DataGrid x:Name="EmployeesDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">
				<DataGrid.Columns>
					<DataGridTextColumn Header="ID"
                                        Binding="{Binding Id}"
                                        Width="70"/>

					<DataGridTextColumn Header="ФИО"
                                        Binding="{Binding FullName}"
                                        Width="280"/>

					<DataGridCheckBoxColumn Header="Активен"
                                            Binding="{Binding IsActive}"
                                            Width="100"/>

					<DataGridCheckBoxColumn Header="Коллцентр"
                                            Binding="{Binding IsCallCenter}"
                                            Width="120"/>

					<DataGridTextColumn Header="Ставка за отзыв"
                                        Binding="{Binding DefaultReviewPaymentRate}"
                                        Width="160"/>

					<DataGridTextColumn Header="Комментарий"
                                        Binding="{Binding Comment}"
                                        Width="*"/>
				</DataGrid.Columns>
			</DataGrid>
		</Border>
	</Grid>
</Window>