<Window x:Class="ClinicStatisticsApp.UI.EmployeesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудники"
        Height="600"
        Width="950"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button Content="Добавить" Width="120" Height="36" Margin="0,0,10,0" Click="AddButton_Click"/>
            <Button Content="Редактировать" Width="140" Height="36" Margin="0,0,10,0" Click="EditButton_Click"/>
            <Button Content="Обновить" Width="120" Height="36" Click="RefreshButton_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="2"
                  x:Name="EmployeesDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="250"/>
                <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="100"/>
                <DataGridCheckBoxColumn Header="Коллцентр" Binding="{Binding IsCallCenter}" Width="120"/>
                <DataGridTextColumn Header="Ставка за отзыв" Binding="{Binding DefaultReviewPaymentRate}" Width="140"/>
                <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>