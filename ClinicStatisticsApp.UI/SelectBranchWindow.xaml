<Window x:Class="ClinicStatisticsApp.UI.SelectBranchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор филиала"
        Height="420"
        Width="520"
        MinHeight="420"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource PageBackgroundSoftBrush}">

    <Grid Margin="16">
        <Border Style="{StaticResource CardBorderStyle}"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}"
                VerticalAlignment="Center"
                Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Выбор филиала"
                           Style="{StaticResource TitleTextStyle}"
                           FontSize="20"
                           HorizontalAlignment="Center"/>

                <TextBlock Grid.Row="2"
                           Text="Выберите филиал для продолжения работы"
                           Style="{StaticResource BodyTextStyle}"
                           FontSize="12"
                           HorizontalAlignment="Center"/>

                <StackPanel Grid.Row="4">
                    <Label Content="Филиал"/>
                    <ComboBox x:Name="BranchComboBox"
                              Height="36"
                              FontSize="13"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              Style="{StaticResource ModernComboBoxStyle}"
                              Margin="0"/>
                </StackPanel>

                <TextBlock x:Name="ErrorTextBlock"
                           Grid.Row="6"
                           Visibility="Collapsed"
                           Foreground="{StaticResource DangerBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"/>

                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1"
                            Content="Открыть"
                            Width="100"
                            Height="34"
                            Margin="0"
                            FontSize="12"
                            Click="OpenButton_Click"/>

                    <Button Grid.Column="3"
                            Content="Отмена"
                            Width="100"
                            Height="34"
                            Margin="0"
                            FontSize="12"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CancelButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>