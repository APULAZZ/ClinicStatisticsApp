<Window x:Class="ClinicStatisticsApp.UI.PerkReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ПЕРК"
        Height="690"
        Width="1080"
        MinHeight="690"
        MinWidth="1080"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Раздел ПЕРК"
                               Style="{StaticResource TitleTextStyle}"
                               FontSize="20"/>

                    <TextBlock Text="Явка, неявка и итог по сотрудникам."
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,4,0,0"
                               FontSize="12"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource PrimaryLightBrush}"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,5"
                        VerticalAlignment="Top">
                    <TextBlock Text="Редактирование"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- Период и действия -->
        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="108"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="108"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Год"/>
                        <ComboBox x:Name="YearComboBox"
                                  Width="140"
                                  Height="32"
                                  Style="{StaticResource ModernComboBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="Месяц"/>
                        <ComboBox x:Name="MonthComboBox"
                                  Width="140"
                                  Height="32"
                                  Style="{StaticResource ModernComboBoxStyle}"/>
                    </StackPanel>

                    <Button Grid.Column="4"
                            Content="Открыть"
                            Width="108"
                            Height="34"
                            Margin="0,26,0,0"
                            FontSize="13"
                            Click="OpenButton_Click"/>

                    <Button Grid.Column="6"
                            Content="Сохранить"
                            Width="108"
                            Height="34"
                            Margin="0,26,0,0"
                            FontSize="13"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="SaveButton_Click"/>

                    <Button Grid.Column="8"
                            Content="Скопировать прошлый"
                            Width="145"
                            Height="34"
                            Margin="0,26,0,0"
                            FontSize="13"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CopyFromPreviousButton_Click"/>

                    <Button Grid.Column="10"
                            Content="Добавить"
                            Width="120"
                            Height="34"
                            Margin="0,26,0,0"
                            FontSize="13"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="AddRowButton_Click"/>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Удалить"
                            Width="120"
                            Height="34"
                            Margin="0"
                            FontSize="13"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="DeleteRowButton_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Таблица -->
        <Border Grid.Row="4"
                Style="{StaticResource CardBorderStyle}"
                Padding="10">
            <DataGrid x:Name="PerkDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CellEditEnding="PerkDataGrid_CellEditEnding"
                      CurrentCellChanged="PerkDataGrid_CurrentCellChanged"
                      RowHeight="28"
                      ColumnHeaderHeight="32"
                      FontSize="13">
                <DataGrid.Resources>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="6,3"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Height" Value="32"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Сотрудник" Width="320">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding EmployeeFullName}"
                                           VerticalAlignment="Center"
                                           FontSize="13"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Employees, RelativeSource={RelativeSource AncestorType=Window}}"
                                          DisplayMemberPath="FullName"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding EmployeeId, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          Height="28"
                                          FontSize="13"
                                          Margin="0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Явка"
                                        Width="100"
                                        Binding="{Binding AttendanceCount, UpdateSourceTrigger=PropertyChanged}"/>

                    <DataGridTextColumn Header="Неявка"
                                        Width="100"
                                        Binding="{Binding AbsenceCount, UpdateSourceTrigger=PropertyChanged}"/>

                    <DataGridTextColumn Header="Всего"
                                        Width="100"
                                        IsReadOnly="True"
                                        Binding="{Binding Total}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Итоги -->
        <Border Grid.Row="6"
                Style="{StaticResource CardBorderStyle}"
                Padding="10">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="1"
                           Text="Итого:"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock x:Name="AttendanceTotalTextBlock"
                           Grid.Column="2"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock x:Name="AbsenceTotalTextBlock"
                           Grid.Column="3"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock x:Name="GrandTotalTextBlock"
                           Grid.Column="4"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource PrimaryDarkBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>