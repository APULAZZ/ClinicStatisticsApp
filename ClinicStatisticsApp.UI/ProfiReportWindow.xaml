<Window x:Class="ClinicStatisticsApp.UI.ProfiReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ПРОФЫ"
        Height="760"
        Width="1120"
        MinHeight="760"
        MinWidth="1120"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Раздел ПРОФЫ"
                               Style="{StaticResource TitleTextStyle}"/>

                    <TextBlock Text="Работа с показателями приглашений, записей и фактических посещений."
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource PrimaryLightBrush}"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,8"
                        VerticalAlignment="Top">
                    <TextBlock Text="Редактирование данных"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- Параметры и действия -->
        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Период и действия"
                           Style="{StaticResource SectionTextStyle}"/>

                <!-- Верхняя строка -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Год"/>
                        <ComboBox x:Name="YearComboBox"
                                  Width="160"
                                  Height="40"
                                  Style="{StaticResource ModernComboBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="Месяц"/>
                        <ComboBox x:Name="MonthComboBox"
                                  Width="160"
                                  Height="40"
                                  Style="{StaticResource ModernComboBoxStyle}"/>
                    </StackPanel>

                    <Button Grid.Column="4"
                            Content="Открыть"
                            Width="140"
                            Height="42"
                            Margin="0,30,0,0"
                            Click="OpenButton_Click"/>

                    <Button Grid.Column="6"
                            Content="Сохранить"
                            Width="140"
                            Height="42"
                            Margin="0,30,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="SaveButton_Click"/>
                </Grid>

                <!-- Нижняя строка -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Добавить строку"
                            Width="180"
                            Height="42"
                            Margin="0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="AddRowButton_Click"/>

                    <Button Grid.Column="2"
                            Content="Скопировать с прошлого месяца"
                            Width="240"
                            Height="42"
                            Margin="0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CopyFromPreviousButton_Click"/>

                    <Button Grid.Column="4"
                            Content="Удалить строку"
                            Width="180"
                            Height="42"
                            Margin="0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="DeleteRowButton_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Таблица -->
        <Border Grid.Row="4"
                Style="{StaticResource CardBorderStyle}"
                Padding="18">
            <DataGrid x:Name="ProfiDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CellEditEnding="ProfiDataGrid_CellEditEnding"
                      CurrentCellChanged="ProfiDataGrid_CurrentCellChanged">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Сотрудник" Width="320">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding EmployeeFullName}"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Employees, RelativeSource={RelativeSource AncestorType=Window}}"
                                          DisplayMemberPath="FullName"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding EmployeeId, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          Height="36"
                                          Margin="0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Пригласили"
                                        Width="160"
                                        Binding="{Binding InvitedCount, UpdateSourceTrigger=PropertyChanged}"/>

                    <DataGridTextColumn Header="Записались"
                                        Width="160"
                                        Binding="{Binding BookedCount, UpdateSourceTrigger=PropertyChanged}"/>

                    <DataGridTextColumn Header="Пришли"
                                        Width="160"
                                        Binding="{Binding ArrivedCount, UpdateSourceTrigger=PropertyChanged}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Итоги -->
        <Border Grid.Row="6"
                Style="{StaticResource CardBorderStyle}">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="1"
                           Text="Итого:"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock x:Name="InvitedTotalTextBlock"
                           Grid.Column="2"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock x:Name="BookedTotalTextBlock"
                           Grid.Column="3"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock x:Name="ArrivedTotalTextBlock"
                           Grid.Column="4"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource PrimaryDarkBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>