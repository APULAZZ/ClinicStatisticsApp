<Window x:Class="ClinicStatisticsApp.UI.ProfiReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ПРОФЫ"
        Height="650"
        Width="1100"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Год:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="YearComboBox" Width="100" Margin="0,0,20,0"/>

                <TextBlock Text="Месяц:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="MonthComboBox" Width="140" Margin="0,0,20,0"/>

                <Button Content="Открыть"
                Width="120"
                Height="34"
                Margin="0,0,10,0"
                Click="OpenButton_Click"/>

                <Button Content="Сохранить"
                Width="120"
                Height="34"
                Click="SaveButton_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Button Content="Добавить строку"
                Width="140"
                Height="34"
                Margin="0,0,10,0"
                Click="AddRowButton_Click"/>

                <Button Content="Скопировать с прошлого месяца"
                Width="220"
                Height="34"
                Margin="0,0,10,0"
                Click="CopyFromPreviousButton_Click"/>

                <Button Content="Удалить строку"
                Width="140"
                Height="34"
                Click="DeleteRowButton_Click"/>
            </StackPanel>
        </StackPanel>

        <DataGrid Grid.Row="2"
                  x:Name="ProfiDataGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
				<DataGridTemplateColumn Header="Сотрудник" Width="300">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding EmployeeFullName}"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
					<DataGridTemplateColumn.CellEditingTemplate>
						<DataTemplate>
							<ComboBox ItemsSource="{Binding DataContext.Employees, RelativeSource={RelativeSource AncestorType=Window}}"
									  DisplayMemberPath="FullName"
									  SelectedValuePath="Id"
									  SelectedValue="{Binding EmployeeId, UpdateSourceTrigger=PropertyChanged}"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellEditingTemplate>
				</DataGridTemplateColumn>

                <DataGridTextColumn Header="Пригласили"
                                    Width="140"
                                    Binding="{Binding InvitedCount, UpdateSourceTrigger=PropertyChanged}"/>

                <DataGridTextColumn Header="Записались"
                                    Width="140"
                                    Binding="{Binding BookedCount, UpdateSourceTrigger=PropertyChanged}"/>

                <DataGridTextColumn Header="Пришли"
                                    Width="140"
                                    Binding="{Binding ArrivedCount, UpdateSourceTrigger=PropertyChanged}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="Итого:"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,15,0"/>

            <TextBlock x:Name="InvitedTotalTextBlock"
                       FontSize="16"
                       Width="140"
                       TextAlignment="Center"/>

            <TextBlock x:Name="BookedTotalTextBlock"
                       FontSize="16"
                       Width="140"
                       TextAlignment="Center"/>

            <TextBlock x:Name="ArrivedTotalTextBlock"
                       FontSize="16"
                       Width="140"
                       TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>