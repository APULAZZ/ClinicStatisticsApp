<Window x:Class="ClinicStatisticsApp.UI.EmployeeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудник"
        Height="700"
        Width="560"
        MinHeight="700"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16">
            <Border Style="{StaticResource CardBorderStyle}"
                    VerticalAlignment="Center"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Редактирование сотрудника"
                               Style="{StaticResource TitleTextStyle}"
                               FontSize="18"/>

                    <TextBlock Grid.Row="2"
                               Text="Данные сотрудника, параметры мотивации и профосмотров"
                               Style="{StaticResource BodyTextStyle}"
                               FontSize="12"/>

                    <StackPanel Grid.Row="4">
                        <Label Content="ФИО"/>
                        <TextBox x:Name="FullNameTextBox"
                                 Height="36"
                                 FontSize="13"
                                 Margin="0"/>
                    </StackPanel>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource MutedBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrushCustom}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12">
                            <CheckBox x:Name="IsActiveCheckBox"
                                      Content="Активен"
                                      VerticalAlignment="Center"
                                      FontSize="13"
                                      FontWeight="SemiBold"/>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{StaticResource MutedBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrushCustom}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12">
                            <CheckBox x:Name="IsCallCenterCheckBox"
                                      Content="Коллцентр"
                                      VerticalAlignment="Center"
                                      FontSize="13"
                                      FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="8">
                        <Label Content="Базовая ставка за отзыв"/>
                        <TextBox x:Name="RateTextBox"
                                 Height="36"
                                 FontSize="13"
                                 Margin="0"/>
                    </StackPanel>

                    <Grid Grid.Row="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Label Content="Ставка профосмотров"/>
                            <ComboBox x:Name="DefaultProfoRateComboBox"
                                      Height="36"
                                      FontSize="13"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      Margin="0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Label Content="Категория профосмотров"/>
                            <ComboBox x:Name="DefaultProfoCategoryComboBox"
                                      Height="36"
                                      FontSize="13"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      Margin="0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="12">
                        <Label Content="Комментарий"/>
                        <TextBox x:Name="CommentTextBox"
                                 Height="100"
                                 FontSize="13"
                                 Margin="0"
                                 VerticalContentAlignment="Top"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"/>
                    </StackPanel>

                    <TextBlock x:Name="ErrorTextBlock"
                               Grid.Row="14"
                               Visibility="Collapsed"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"/>

                    <Grid Grid.Row="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1"
                                Content="Сохранить"
                                Width="100"
                                Height="34"
                                Margin="0"
                                FontSize="12"
                                Click="SaveButton_Click"/>

                        <Button Grid.Column="3"
                                Content="Отмена"
                                Width="100"
                                Height="34"
                                Margin="0"
                                FontSize="12"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CancelButton_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>