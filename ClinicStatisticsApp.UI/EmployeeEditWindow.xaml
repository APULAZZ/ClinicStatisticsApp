<Window x:Class="ClinicStatisticsApp.UI.EmployeeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудник"
        Height="430"
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
	<Grid Margin="20">
		<Border VerticalAlignment="Center">
			<StackPanel>
				<TextBlock Text="ФИО" Margin="0,0,0,5"/>
				<TextBox x:Name="FullNameTextBox"
                         Height="30"
                         Margin="0,0,0,15"/>

				<CheckBox x:Name="IsActiveCheckBox"
                          Content="Активен"
                          Margin="0,0,0,10"/>

				<CheckBox x:Name="IsCallCenterCheckBox"
                          Content="Коллцентр"
                          Margin="0,0,0,15"/>

				<TextBlock Text="Базовая ставка за отзыв" Margin="0,0,0,5"/>
				<TextBox x:Name="RateTextBox"
                         Height="30"
                         Margin="0,0,0,15"/>

				<TextBlock Text="Комментарий" Margin="0,0,0,5"/>
				<TextBox x:Name="CommentTextBox"
                         Height="80"
                         Margin="0,0,0,20"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"/>

				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
					<Button Content="Сохранить"
                            Width="110"
                            Height="34"
                            Margin="0,0,10,0"
                            Click="SaveButton_Click"/>
					<Button Content="Отмена"
                            Width="110"
                            Height="34"
                            Click="CancelButton_Click"/>
				</StackPanel>
			</StackPanel>
		</Border>
	</Grid>
</Window>