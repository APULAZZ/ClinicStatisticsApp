<Window x:Class="ClinicStatisticsApp.UI.EmployeeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудник"
        Height="720"
        Width="560"
        MinHeight="690"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Border Style="{StaticResource CardBorderStyle}"
                    VerticalAlignment="Center"
                    Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <TextBlock Text="Редактирование сотрудника"
                               Style="{StaticResource TitleTextStyle}"/>

                    <TextBlock Grid.Row="2"
                               Text="Укажите данные сотрудника, статус и параметры мотивации"
                               Style="{StaticResource BodyTextStyle}"/>

                    <!-- ФИО -->
                    <StackPanel Grid.Row="4">
                        <Label Content="ФИО"/>
                        <TextBox x:Name="FullNameTextBox"/>
                    </StackPanel>

                    <!-- Флаги -->
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource MutedBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrushCustom}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14">
                            <CheckBox x:Name="IsActiveCheckBox"
                                      Content="Активен"
                                      VerticalAlignment="Center"
                                      FontSize="14"
                                      FontWeight="SemiBold"/>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{StaticResource MutedBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrushCustom}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14">
                            <CheckBox x:Name="IsCallCenterCheckBox"
                                      Content="Коллцентр"
                                      VerticalAlignment="Center"
                                      FontSize="14"
                                      FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <!-- Ставка -->
                    <StackPanel Grid.Row="8">
                        <Label Content="Базовая ставка за отзыв"/>
                        <TextBox x:Name="RateTextBox"/>
                    </StackPanel>

                    <!-- Комментарий -->
                    <StackPanel Grid.Row="10">
                        <Label Content="Комментарий"/>
                        <TextBox x:Name="CommentTextBox"
                                 Height="130"
                                 VerticalContentAlignment="Top"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"/>
                    </StackPanel>

                    <!-- Ошибка -->
                    <TextBlock x:Name="ErrorTextBlock"
                               Grid.Row="12"
                               Visibility="Collapsed"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"/>

                    <!-- Кнопки -->
                    <Grid Grid.Row="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1"
                                Content="Сохранить"
                                Width="120"
                                Height="42"
                                Margin="0"
                                Click="SaveButton_Click"/>

                        <Button Grid.Column="3"
                                Content="Отмена"
                                Width="120"
                                Height="42"
                                Margin="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CancelButton_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>