<Window x:Class="ClinicStatisticsApp.UI.SummaryProDoctorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отзывы ПроДокторов"
        Height="980"
        Width="1580"
        MinHeight="920"
        MinWidth="1380"
        WindowStartupLocation="CenterOwner">

	<Grid Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="18"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="18"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Шапка -->
		<Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<StackPanel>
					<TextBlock Text="Отзывы ПроДокторов"
                               Style="{StaticResource TitleTextStyle}"/>

					<TextBlock Text="Просмотр помесячной статистики по администраторам и редактирование значений QR-кодов."
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,8,0,0"/>
				</StackPanel>

				<Border Grid.Column="1"
                        Background="{StaticResource PrimaryLightBrush}"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,8"
                        VerticalAlignment="Top">
					<TextBlock Text="Отчеты и QR"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"/>
				</Border>
			</Grid>
		</Border>

		<!-- Параметры -->
		<Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="18"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<TextBlock Text="Параметры"
                           Style="{StaticResource SectionTextStyle}"/>

				<Grid Grid.Row="2">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="160"/>
						<ColumnDefinition Width="12"/>
						<ColumnDefinition Width="140"/>
						<ColumnDefinition Width="12"/>
						<ColumnDefinition Width="140"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0">
						<Label Content="Год"/>
						<ComboBox x:Name="YearComboBox"
                                  Width="160"
                                  Height="40"
                                  Style="{StaticResource ModernComboBoxStyle}"/>
					</StackPanel>

					<Button Grid.Column="2"
                            Content="Загрузить"
                            Width="140"
                            Height="42"
                            Margin="0,30,0,0"
                            Click="LoadButton_Click"/>

					<Button Grid.Column="4"
                            Content="Сохранить QR"
                            Width="140"
                            Height="42"
                            Margin="0,30,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="SaveButton_Click"/>
				</Grid>
			</Grid>
		</Border>

		<!-- Контент -->
		<Border Grid.Row="4"
                Style="{StaticResource CardBorderStyle}"
                Padding="18">
			<ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
				<StackPanel x:Name="BlocksPanel"/>
			</ScrollViewer>
		</Border>
	</Grid>
</Window>