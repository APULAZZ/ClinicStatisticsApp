<UserControl x:Class="ClinicStatisticsApp.UI.SummaryProDoctorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource PageBackgroundSoftBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
            Content="← Назад"
            Width="82"
            Height="30"
            Margin="0"
            FontSize="11"
            Style="{StaticResource SecondaryButtonStyle}"
            Click="BackButton_Click"/>

                <StackPanel    Grid.Column="2">
                    <TextBlock Text="Отзывы ПроДокторов"
                               Style="{StaticResource TitleTextStyle}"
                               FontSize="18"/>
                    <TextBlock Text="Статистика по администраторам и редактирование QR-кодов."
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,2,0,0"
                               FontSize="11"/>
                </StackPanel>

                <Border Grid.Column="3"
                        Background="{StaticResource PrimaryLightBrush}"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,4"
                        VerticalAlignment="Top">
                    <TextBlock Text="Отчеты и QR"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Label Content="Год"/>
                    <ComboBox x:Name="YearComboBox"
                              Width="130"
                              Height="30"
                              FontSize="12"
                              Style="{StaticResource ModernComboBoxStyle}"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Загрузить"
                        Width="110"
                        Height="32"
                        Margin="0,24,0,0"
                        FontSize="12"
                        Click="LoadButton_Click"/>

                <Button Grid.Column="4"
                        Content="Сохранить QR"
                        Width="110"
                        Height="32"
                        Margin="0,24,0,0"
                        FontSize="12"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="SaveButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="BlocksPanel"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
