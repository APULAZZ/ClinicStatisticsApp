<UserControl x:Class="ClinicStatisticsApp.UI.AbsolutePrimaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource PageBackgroundSoftBrush}">

    <UserControl.Resources>
        <Style x:Key="CenteredCellTextStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BranchCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="TotalCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CenteredCellTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="10"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="← Назад"
                        Width="82"
                        Height="30"
                        Margin="0"
                        FontSize="11"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BackButton_Click"/>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Статистика абсолютных первичных"
                               Style="{StaticResource TitleTextStyle}"
                               FontSize="18"/>

                    <TextBlock Text="Помесячная сводка по филиалам: филиал, колл-центр и итог."
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,2,0,0"
                               FontSize="11"/>
                </StackPanel>

                <Border Grid.Column="3"
                        Background="{StaticResource SubtleAccentBrush}"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,4"
                        VerticalAlignment="Top">
                    <TextBlock Text="Аналитический отчет"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}"
                Padding="10"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Label Content="Год"/>
                    <ComboBox x:Name="YearComboBox"
                              Width="130"
                              Height="30"
                              FontSize="12"
                              Style="{StaticResource ModernComboBoxStyle}"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Построить"
                        Width="110"
                        Height="32"
                        Margin="0,24,0,0"
                        FontSize="12"
                        Click="BuildButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Style="{StaticResource CardBorderStyle}"
                Padding="8"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}">
            <DataGrid x:Name="AbsolutePrimaryDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      FrozenColumnCount="1"
                      RowHeight="26"
                      ColumnHeaderHeight="32"
                      FontSize="12"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#E5E7EB"
                      VerticalGridLinesBrush="#E5E7EB">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Филиал" Binding="{Binding BranchName}" Width="160" ElementStyle="{StaticResource BranchCellTextStyle}"/>

                    <DataGridTextColumn Header="Янв ФЛ" Binding="{Binding JanuaryBranch}" Width="75" ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                    <DataGridTextColumn Header="Янв КЦ" Binding="{Binding JanuaryCallCenter}" Width="75" ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                    <DataGridTextColumn Header="Янв Итого" Binding="{Binding JanuaryTotal}" Width="85" ElementStyle="{StaticResource TotalCellTextStyle}"/>

                    <DataGridTextColumn Header="Фев ФЛ" Binding="{Binding FebruaryBranch}" Width="75" ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                    <DataGridTextColumn Header="Фев КЦ" Binding="{Binding FebruaryCallCenter}" Width="75" ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                    <DataGridTextColumn Header="Фев Итого" Binding="{Binding FebruaryTotal}" Width="85" ElementStyle="{StaticResource TotalCellTextStyle}"/>

                    <DataGridTextColumn Header="Мар ФЛ" Binding="{Binding MarchBranch}" Width="75" ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                    <DataGridTextColumn Header="Мар КЦ" Binding="{Binding MarchCallCenter}" Width="75" ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                    <DataGridTextColumn Header="Мар Итого" Binding="{Binding MarchTotal}" Width="85" ElementStyle="{StaticResource TotalCellTextStyle}"/>

                    <DataGridTextColumn Header="Апр ФЛ" Binding="{Binding AprilBranch}" Width="75" ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                    <DataGridTextColumn Header="Апр КЦ" Binding="{Binding AprilCallCenter}" Width="75" ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                    <DataGridTextColumn Header="Апр Итого" Binding="{Binding AprilTotal}" Width="85" ElementStyle="{StaticResource TotalCellTextStyle}"/>

                    <DataGridTextColumn Header="Май ФЛ" Binding="{Binding MayBranch}" Width="75" ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                    <DataGridTextColumn Header="Май КЦ" Binding="{Binding MayCallCenter}" Width="75" ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                    <DataGridTextColumn Header="Май Итого" Binding="{Binding MayTotal}" Width="85" ElementStyle="{StaticResource TotalCellTextStyle}"/>

                    <DataGridTextColumn Header="Июн ФЛ" Binding="{Binding JuneBranch}" Width="75" ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                    <DataGridTextColumn Header="Июн КЦ" Binding="{Binding JuneCallCenter}" Width="75" ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                    <DataGridTextColumn Header="Июн Итого" Binding="{Binding JuneTotal}" Width="85" ElementStyle="{StaticResource TotalCellTextStyle}"/>

                    <DataGridTextColumn Header="Июл ФЛ" Binding="{Binding JulyBranch}" Width="75" ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                    <DataGridTextColumn Header="Июл КЦ" Binding="{Binding JulyCallCenter}" Width="75" ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                    <DataGridTextColumn Header="Июл Итого" Binding="{Binding JulyTotal}" Width="85" ElementStyle="{StaticResource TotalCellTextStyle}"/>

                    <DataGridTextColumn Header="Авг ФЛ" Binding="{Binding AugustBranch}" Width="75" ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                    <DataGridTextColumn Header="Авг КЦ" Binding="{Binding AugustCallCenter}" Width="75" ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                    <DataGridTextColumn Header="Авг Итого" Binding="{Binding AugustTotal}" Width="85" ElementStyle="{StaticResource TotalCellTextStyle}"/>

                    <DataGridTextColumn Header="Сен ФЛ" Binding="{Binding SeptemberBranch}" Width="75" ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                    <DataGridTextColumn Header="Сен КЦ" Binding="{Binding SeptemberCallCenter}" Width="75" ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                    <DataGridTextColumn Header="Сен Итого" Binding="{Binding SeptemberTotal}" Width="85" ElementStyle="{StaticResource TotalCellTextStyle}"/>

                    <DataGridTextColumn Header="Окт ФЛ" Binding="{Binding OctoberBranch}" Width="75" ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                    <DataGridTextColumn Header="Окт КЦ" Binding="{Binding OctoberCallCenter}" Width="75" ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                    <DataGridTextColumn Header="Окт Итого" Binding="{Binding OctoberTotal}" Width="85" ElementStyle="{StaticResource TotalCellTextStyle}"/>

                    <DataGridTextColumn Header="Ноя ФЛ" Binding="{Binding NovemberBranch}" Width="75" ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                    <DataGridTextColumn Header="Ноя КЦ" Binding="{Binding NovemberCallCenter}" Width="75" ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                    <DataGridTextColumn Header="Ноя Итого" Binding="{Binding NovemberTotal}" Width="85" ElementStyle="{StaticResource TotalCellTextStyle}"/>

                    <DataGridTextColumn Header="Дек ФЛ" Binding="{Binding DecemberBranch}" Width="75" ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                    <DataGridTextColumn Header="Дек КЦ" Binding="{Binding DecemberCallCenter}" Width="75" ElementStyle="{StaticResource CenteredCellTextStyle}"/>
                    <DataGridTextColumn Header="Дек Итого" Binding="{Binding DecemberTotal}" Width="85" ElementStyle="{StaticResource TotalCellTextStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="6"
                Style="{StaticResource CardBorderStyle}"
                Padding="10"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}">
            <StackPanel>
                <TextBlock Text="Суммарные итоги по месяцам"
                           Style="{StaticResource SectionTextStyle}"
                           FontSize="15"/>

                <TextBlock x:Name="TotalsTextBlock"
                           Margin="0,6,0,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryDarkBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
