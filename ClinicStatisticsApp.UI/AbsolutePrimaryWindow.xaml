<Window x:Class="ClinicStatisticsApp.UI.AbsolutePrimaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Статистика абсолютных первичных"
        Height="850"
        Width="1700"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Год:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="YearComboBox" Width="100" Margin="0,0,20,0"/>
            <Button Content="Построить" Width="140" Height="34" Click="BuildButton_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="2"
                  x:Name="AbsolutePrimaryDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Филиал" Binding="{Binding BranchName}" Width="150"/>

                <DataGridTextColumn Header="Янв ФЛ" Binding="{Binding JanuaryBranch}" Width="70"/>
                <DataGridTextColumn Header="Янв КЦ" Binding="{Binding JanuaryCallCenter}" Width="70"/>
                <DataGridTextColumn Header="Янв Итого" Binding="{Binding JanuaryTotal}" Width="80"/>

                <DataGridTextColumn Header="Фев ФЛ" Binding="{Binding FebruaryBranch}" Width="70"/>
                <DataGridTextColumn Header="Фев КЦ" Binding="{Binding FebruaryCallCenter}" Width="70"/>
                <DataGridTextColumn Header="Фев Итого" Binding="{Binding FebruaryTotal}" Width="80"/>

                <DataGridTextColumn Header="Мар ФЛ" Binding="{Binding MarchBranch}" Width="70"/>
                <DataGridTextColumn Header="Мар КЦ" Binding="{Binding MarchCallCenter}" Width="70"/>
                <DataGridTextColumn Header="Мар Итого" Binding="{Binding MarchTotal}" Width="80"/>

                <DataGridTextColumn Header="Апр ФЛ" Binding="{Binding AprilBranch}" Width="70"/>
                <DataGridTextColumn Header="Апр КЦ" Binding="{Binding AprilCallCenter}" Width="70"/>
                <DataGridTextColumn Header="Апр Итого" Binding="{Binding AprilTotal}" Width="80"/>

                <DataGridTextColumn Header="Май ФЛ" Binding="{Binding MayBranch}" Width="70"/>
                <DataGridTextColumn Header="Май КЦ" Binding="{Binding MayCallCenter}" Width="70"/>
                <DataGridTextColumn Header="Май Итого" Binding="{Binding MayTotal}" Width="80"/>

                <DataGridTextColumn Header="Июн ФЛ" Binding="{Binding JuneBranch}" Width="70"/>
                <DataGridTextColumn Header="Июн КЦ" Binding="{Binding JuneCallCenter}" Width="70"/>
                <DataGridTextColumn Header="Июн Итого" Binding="{Binding JuneTotal}" Width="80"/>

                <DataGridTextColumn Header="Июл ФЛ" Binding="{Binding JulyBranch}" Width="70"/>
                <DataGridTextColumn Header="Июл КЦ" Binding="{Binding JulyCallCenter}" Width="70"/>
                <DataGridTextColumn Header="Июл Итого" Binding="{Binding JulyTotal}" Width="80"/>

                <DataGridTextColumn Header="Авг ФЛ" Binding="{Binding AugustBranch}" Width="70"/>
                <DataGridTextColumn Header="Авг КЦ" Binding="{Binding AugustCallCenter}" Width="70"/>
                <DataGridTextColumn Header="Авг Итого" Binding="{Binding AugustTotal}" Width="80"/>

                <DataGridTextColumn Header="Сен ФЛ" Binding="{Binding SeptemberBranch}" Width="70"/>
                <DataGridTextColumn Header="Сен КЦ" Binding="{Binding SeptemberCallCenter}" Width="70"/>
                <DataGridTextColumn Header="Сен Итого" Binding="{Binding SeptemberTotal}" Width="80"/>

                <DataGridTextColumn Header="Окт ФЛ" Binding="{Binding OctoberBranch}" Width="70"/>
                <DataGridTextColumn Header="Окт КЦ" Binding="{Binding OctoberCallCenter}" Width="70"/>
                <DataGridTextColumn Header="Окт Итого" Binding="{Binding OctoberTotal}" Width="80"/>

                <DataGridTextColumn Header="Ноя ФЛ" Binding="{Binding NovemberBranch}" Width="70"/>
                <DataGridTextColumn Header="Ноя КЦ" Binding="{Binding NovemberCallCenter}" Width="70"/>
                <DataGridTextColumn Header="Ноя Итого" Binding="{Binding NovemberTotal}" Width="80"/>

                <DataGridTextColumn Header="Дек ФЛ" Binding="{Binding DecemberBranch}" Width="70"/>
                <DataGridTextColumn Header="Дек КЦ" Binding="{Binding DecemberCallCenter}" Width="70"/>
                <DataGridTextColumn Header="Дек Итого" Binding="{Binding DecemberTotal}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4"
                   x:Name="TotalsTextBlock"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#1E4E8C"/>
    </Grid>
</Window>