<Window x:Class="ClinicStatisticsApp.UI.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пользователь"
        Height="700"
        Width="560"
        MinHeight="700"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Border Style="{StaticResource CardBorderStyle}"
                    VerticalAlignment="Center"
                    Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <TextBlock Text="Редактирование пользователя"
                               Style="{StaticResource TitleTextStyle}"/>

                    <TextBlock Grid.Row="2"
                               Text="Заполните данные учетной записи и права доступа"
                               Style="{StaticResource BodyTextStyle}"/>

                    <!-- Логин -->
                    <StackPanel Grid.Row="4">
                        <Label Content="Логин"/>
                        <TextBox x:Name="LoginTextBox"/>
                    </StackPanel>

                    <!-- Пароль -->
                    <StackPanel Grid.Row="6">
                        <Label Content="Пароль"/>
                        <TextBox x:Name="PasswordTextBox"/>
                    </StackPanel>

                    <!-- ФИО -->
                    <StackPanel Grid.Row="8">
                        <Label Content="ФИО"/>
                        <TextBox x:Name="FullNameTextBox"/>
                    </StackPanel>

                    <!-- Роль -->
                    <StackPanel Grid.Row="10">
                        <Label Content="Роль"/>
                        <ComboBox x:Name="RoleComboBox"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  SelectionChanged="RoleComboBox_SelectionChanged"/>
                    </StackPanel>

                    <!-- Филиал -->
                    <StackPanel Grid.Row="12">
                        <Label Content="Филиал"/>
                        <ComboBox x:Name="BranchComboBox"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  Style="{StaticResource ModernComboBoxStyle}"/>
                    </StackPanel>

                    <!-- Активность -->
                    <Border Grid.Row="14"
                            Background="{StaticResource MutedBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrushCustom}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14">
                        <CheckBox x:Name="IsActiveCheckBox"
                                  Content="Активен"
                                  VerticalAlignment="Center"
                                  FontSize="14"
                                  FontWeight="SemiBold"/>
                    </Border>

                    <!-- Ошибка -->
                    <TextBlock x:Name="ErrorTextBlock"
                               Grid.Row="16"
                               Visibility="Collapsed"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"/>

                    <!-- Кнопки -->
                    <Grid Grid.Row="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1"
                                Content="Сохранить"
                                Width="120"
                                Height="42"
                                Margin="0"
                                Click="SaveButton_Click"/>

                        <Button Grid.Column="3"
                                Content="Отмена"
                                Width="120"
                                Height="42"
                                Margin="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CancelButton_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>