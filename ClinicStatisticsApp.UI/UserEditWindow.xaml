<Window x:Class="ClinicStatisticsApp.UI.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пользователь"
        Height="520"
        Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
	<Grid Margin="20">
		<Border VerticalAlignment="Center">
			<StackPanel>
				<TextBlock Text="Логин" Margin="0,0,0,5"/>
				<TextBox x:Name="LoginTextBox" Height="30" Margin="0,0,0,15"/>

				<TextBlock Text="Пароль" Margin="0,0,0,5"/>
				<TextBox x:Name="PasswordTextBox" Height="30" Margin="0,0,0,15"/>

				<TextBlock Text="ФИО" Margin="0,0,0,5"/>
				<TextBox x:Name="FullNameTextBox" Height="30" Margin="0,0,0,15"/>

				<TextBlock Text="Роль" Margin="0,0,0,5"/>
				<ComboBox x:Name="RoleComboBox"
                          Height="30"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          Margin="0,0,0,15"
                          SelectionChanged="RoleComboBox_SelectionChanged"/>

				<TextBlock Text="Филиал" Margin="0,0,0,5"/>
				<ComboBox x:Name="BranchComboBox"
                          Height="30"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          Margin="0,0,0,15"/>

				<CheckBox x:Name="IsActiveCheckBox"
                          Content="Активен"
                          Margin="0,0,0,20"/>

				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
					<Button Content="Сохранить"
                            Width="110"
                            Height="34"
                            Margin="0,0,10,0"
                            Click="SaveButton_Click"/>
					<Button Content="Отмена"
                            Width="110"
                            Height="34"
                            Click="CancelButton_Click"/>
				</StackPanel>
			</StackPanel>
		</Border>
	</Grid>
</Window>