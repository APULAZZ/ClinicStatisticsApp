<Window x:Class="ClinicStatisticsApp.UI.CallDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Карточка звонка" Width="620" Height="620" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Карточка звонка" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AppText}"/>
            <TextBlock x:Name="DateTextBlock" Margin="0,7,0,20" Foreground="{DynamicResource AppMutedText}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{DynamicResource AppSurface}" CornerRadius="12" Padding="20" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                        <TextBlock Text="Сотрудник" Foreground="{DynamicResource AppMutedText}"/><TextBlock x:Name="EmployeeTextBlock" Grid.Column="1" Foreground="{DynamicResource AppText}"/>
                        <TextBlock Grid.Row="1" Text="Группа" Foreground="{DynamicResource AppMutedText}"/><TextBlock x:Name="GroupTextBlock" Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource AppText}"/>
                        <TextBlock Grid.Row="2" Text="Номер" Foreground="{DynamicResource AppMutedText}"/><TextBlock x:Name="PhoneTextBlock" Grid.Row="2" Grid.Column="1" Foreground="{DynamicResource AppText}"/>
                        <TextBlock Grid.Row="3" Text="Направление" Foreground="{DynamicResource AppMutedText}"/><TextBlock x:Name="DirectionTextBlock" Grid.Row="3" Grid.Column="1" Foreground="{DynamicResource AppText}"/>
                        <TextBlock Grid.Row="4" Text="Тематика" Foreground="{DynamicResource AppMutedText}"/><TextBlock x:Name="TopicTextBlock" Grid.Row="4" Grid.Column="1" Foreground="{DynamicResource AppText}"/>
                        <TextBlock Grid.Row="5" Text="Длительность" Foreground="{DynamicResource AppMutedText}"/><TextBlock x:Name="DurationTextBlock" Grid.Row="5" Grid.Column="1" Foreground="{DynamicResource AppText}"/>
                    </Grid>
                </Border>
                <Border Background="{DynamicResource AppSurface}" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Запись разговора" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppText}"/>
                        <TextBlock x:Name="RecordingTextBlock" Margin="0,10,0,0" Foreground="{DynamicResource AppMutedText}" TextWrapping="Wrap"/>
                        <MediaElement x:Name="AudioPlayer" LoadedBehavior="Manual" UnloadedBehavior="Manual" Height="0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="PlayButton" Content="▶ Прослушать" Width="110" Height="32" Margin="0,0,10,0" Click="PlayButton_Click" IsEnabled="False"/>
                            <Button x:Name="DownloadButton" Content="⇩ Скачать" Width="90" Height="32" Click="DownloadButton_Click" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="2" Content="Закрыть" Width="100" Height="34" HorizontalAlignment="Right" Margin="0,18,0,0" Click="CloseButton_Click"/>
    </Grid>
</Window>
