<Window x:Class="ClinicStatisticsApp.UI.NaradWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Наряд"
        Height="780"
        Width="1220"
        MinHeight="780"
        MinWidth="1220"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Наряд по мотивационной оплате"
                               Style="{StaticResource TitleTextStyle}"/>

                    <TextBlock x:Name="HeaderTextBlock"
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource PrimaryLightBrush}"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,8"
                        VerticalAlignment="Top">
                    <TextBlock Text="Расчет и экспорт"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- Параметры и действия -->
        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Период и действия"
                           Style="{StaticResource SectionTextStyle}"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Год"/>
                        <ComboBox x:Name="YearComboBox"
                                  Width="160"
                                  Height="40"
                                  Style="{StaticResource ModernComboBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="Месяц"/>
                        <ComboBox x:Name="MonthComboBox"
                                  Width="160"
                                  Height="40"
                                  Style="{StaticResource ModernComboBoxStyle}"/>
                    </StackPanel>

                    <Button Grid.Column="4"
                            Content="Открыть"
                            Width="140"
                            Height="42"
                            Margin="0,30,0,0"
                            Click="OpenButton_Click"/>

                    <Button Grid.Column="6"
                            Content="Сохранить"
                            Width="140"
                            Height="42"
                            Margin="0,30,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="SaveButton_Click"/>

                    <Button Grid.Column="8"
                            Content="Экспорт в Excel"
                            Width="160"
                            Height="42"
                            Margin="0,30,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ExportExcelButton_Click"/>

                    <Button Grid.Column="10"
                            Content="Экспорт в PDF"
                            Width="150"
                            Height="42"
                            Margin="0,30,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ExportPdfButton_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Таблица -->
        <Border Grid.Row="4"
                Style="{StaticResource CardBorderStyle}"
                Padding="18">
            <DataGrid x:Name="NaradDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CellEditEnding="NaradDataGrid_CellEditEnding"
                      CurrentCellChanged="NaradDataGrid_CurrentCellChanged">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Включен"
                                            Width="100"
                                            Binding="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"/>

                    <DataGridTextColumn Header="Сотрудник"
                                        Width="260"
                                        IsReadOnly="True"
                                        Binding="{Binding EmployeeFullName}"/>

                    <DataGridTextColumn Header="Отправлено СМС"
                                        Width="150"
                                        IsReadOnly="True"
                                        Binding="{Binding SmsSentCount}"/>

                    <DataGridTextColumn Header="Оставлено отзывов"
                                        Width="170"
                                        IsReadOnly="True"
                                        Binding="{Binding ReviewsLeftCount}"/>

                    <DataGridTextColumn Header="Оплата за 1 отзыв"
                                        Width="170"
                                        Binding="{Binding PaymentPerReview, UpdateSourceTrigger=PropertyChanged}"/>

                    <DataGridTextColumn Header="Сумма к оплате"
                                        Width="170"
                                        IsReadOnly="True"
                                        Binding="{Binding TotalPayment}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Итоги -->
        <Border Grid.Row="6"
                Style="{StaticResource CardBorderStyle}">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="1"
                           Text="Итого:"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock x:Name="SmsTotalTextBlock"
                           Grid.Column="2"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock x:Name="ReviewsTotalTextBlock"
                           Grid.Column="3"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock Grid.Column="4"/>

                <TextBlock x:Name="PaymentTotalTextBlock"
                           Grid.Column="5"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource PrimaryDarkBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>