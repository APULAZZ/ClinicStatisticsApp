<Window x:Class="ClinicStatisticsApp.UI.NaradWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Наряд"
        Height="700"
        Width="1220"
        MinHeight="700"
        MinWidth="1220"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="CenteredCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LeftCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TotalCellStyle" TargetType="TextBlock" BasedOn="{StaticResource CenteredCellStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Наряд по мотивационной оплате"
                               Style="{StaticResource TitleTextStyle}"
                               FontSize="18"/>

                    <TextBlock x:Name="HeaderTextBlock"
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,2,0,0"
                               FontSize="11"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource PrimaryLightBrush}"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,4"
                        VerticalAlignment="Top">
                    <TextBlock Text="Расчет и экспорт"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- Параметры и действия -->
        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="118"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="118"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Label Content="Год"/>
                    <ComboBox x:Name="YearComboBox"
                              Width="118"
                              Height="30"
                              FontSize="12"
                              Style="{StaticResource ModernComboBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Label Content="Месяц"/>
                    <ComboBox x:Name="MonthComboBox"
                              Width="118"
                              Height="30"
                              FontSize="12"
                              Style="{StaticResource ModernComboBoxStyle}"/>
                </StackPanel>

                <Button Grid.Column="4"
                        Content="Открыть"
                        Width="90"
                        Height="32"
                        Margin="0,24,0,0"
                        FontSize="12"
                        Click="OpenButton_Click"/>

                <Button Grid.Column="6"
                        Content="Сохранить"
                        Width="90"
                        Height="32"
                        Margin="0,24,0,0"
                        FontSize="12"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="SaveButton_Click"/>

                <Button Grid.Column="8"
                        Content="Excel"
                        Width="120"
                        Height="32"
                        Margin="0,24,0,0"
                        FontSize="12"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="ExportExcelButton_Click"/>

                <Button Grid.Column="10"
                        Content="PDF"
                        Width="110"
                        Height="32"
                        Margin="0,24,0,0"
                        FontSize="12"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="ExportPdfButton_Click"/>
            </Grid>
        </Border>

        <!-- Таблица -->
        <Border Grid.Row="4"
                Style="{StaticResource CardBorderStyle}"
                Padding="8">
            <DataGrid x:Name="NaradDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CellEditEnding="NaradDataGrid_CellEditEnding"
                      CurrentCellChanged="NaradDataGrid_CurrentCellChanged"
                      RowHeight="26"
                      ColumnHeaderHeight="30"
                      FontSize="12"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#E5E7EB"
                      VerticalGridLinesBrush="#E5E7EB">
                <DataGrid.Resources>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="6,2"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>

                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Height" Value="30"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="BorderBrush" Value="#D1D5DB"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Вкл."
                                            Width="70"
                                            Binding="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"/>

                    <DataGridTextColumn Header="Сотрудник"
                                        Width="240"
                                        IsReadOnly="True"
                                        Binding="{Binding EmployeeFullName}"
                                        ElementStyle="{StaticResource LeftCellStyle}"/>

                    <DataGridTextColumn Header="СМС"
                                        Width="80"
                                        IsReadOnly="True"
                                        Binding="{Binding SmsSentCount}"
                                        ElementStyle="{StaticResource CenteredCellStyle}"/>

                    <DataGridTextColumn Header="Отзывы"
                                        Width="90"
                                        IsReadOnly="True"
                                        Binding="{Binding ReviewsLeftCount}"
                                        ElementStyle="{StaticResource CenteredCellStyle}"/>

                    <DataGridTextColumn Header="Ставка"
                                        Width="100"
                                        Binding="{Binding PaymentPerReview, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource CenteredCellStyle}"/>

                    <DataGridTextColumn Header="К оплате"
                                        Width="100"
                                        IsReadOnly="True"
                                        Binding="{Binding TotalPayment}"
                                        ElementStyle="{StaticResource TotalCellStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Итоги -->
        <Border Grid.Row="6"
                Style="{StaticResource CardBorderStyle}"
                Padding="8">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="1"
                           Text="Итого:"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock x:Name="SmsTotalTextBlock"
                           Grid.Column="2"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock x:Name="ReviewsTotalTextBlock"
                           Grid.Column="3"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock Grid.Column="4"/>

                <TextBlock x:Name="PaymentTotalTextBlock"
                           Grid.Column="5"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource PrimaryDarkBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>