<Window x:Class="ClinicStatisticsApp.UI.BranchReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Филиальный отчет"
        Height="720"
        Width="920"
        MinHeight="720"
        MinWidth="920"
        WindowStartupLocation="CenterOwner">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Border Grid.Row="0"
                    Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="HeaderTextBlock"
                                   Style="{StaticResource TitleTextStyle}"/>

                        <TextBlock x:Name="PeriodTextBlock"
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{StaticResource PrimaryLightBrush}"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14,8"
                            VerticalAlignment="Top">
                        <TextBlock Text="Управление отчетом"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Параметры -->
            <Border Grid.Row="2"
                    Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Параметры периода"
                               Style="{StaticResource SectionTextStyle}"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Label Content="Год"/>
                            <ComboBox x:Name="YearComboBox"
                                      Width="160"
                                      Height="40"
                                      VerticalContentAlignment="Center"
                                      HorizontalContentAlignment="Center"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      SelectionChanged="PeriodChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Label Content="Месяц"/>
                            <ComboBox x:Name="MonthComboBox"
                                      Width="160"
                                      Height="40"
                                      VerticalContentAlignment="Center"
                                      HorizontalContentAlignment="Center"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      SelectionChanged="PeriodChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <Label Content="Статус периода"/>
                            <Border x:Name="StatusBadgeBorder"
                                    Width="160"
                                    Height="40"
                                    Background="{StaticResource MutedBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrushCustom}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="StatusTextBlock"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="ClosePeriodButton"
                                Grid.Column="0"
                                Content="Закрыть период"
                                Width="160"
                                Height="42"
                                Margin="0"
                                Click="ClosePeriodButton_Click"/>

                        <Button x:Name="ReopenPeriodButton"
                                Grid.Column="2"
                                Content="Открыть период"
                                Width="160"
                                Height="42"
                                Margin="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ReopenPeriodButton_Click"/>

                        <Button x:Name="ExportExcelButton"
                                Grid.Column="4"
                                Content="Экспорт в Excel"
                                Width="160"
                                Height="42"
                                Margin="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ExportExcelButton_Click"/>

                        <Button x:Name="ExportPdfButton"
                                Grid.Column="6"
                                Content="Экспорт в PDF"
                                Width="160"
                                Height="42"
                                Margin="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ExportPdfButton_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Разделы отчета -->
            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Разделы отчета"
                           Style="{StaticResource SectionTextStyle}"/>

                <UniformGrid Grid.Row="2"
                             Rows="2"
                             Columns="2">

                    <Button Click="PerkButton_Click"
                            Style="{StaticResource FeatureCardButtonStyle}"
                            Height="78"
                            Margin="6">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="14,0">
                            <Border Width="32"
                                    Height="32"
                                    CornerRadius="8"
                                    Background="#EEF2FF">
                                <Viewbox Margin="7">
                                    <TextBlock Text="📊"/>
                                </Viewbox>
                            </Border>

                            <TextBlock Text="ПЕРК"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>

                    <Button Click="ProfiButton_Click"
                            Style="{StaticResource FeatureCardButtonStyle}"
                            Height="78"
                            Margin="6">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="14,0">
                            <Border Width="32"
                                    Height="32"
                                    CornerRadius="8"
                                    Background="#ECFDF5">
                                <Viewbox Margin="7">
                                    <TextBlock Text="👥"/>
                                </Viewbox>
                            </Border>

                            <TextBlock Text="ПРОФЫ"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>

                    <Button Click="HoursButton_Click"
                            Style="{StaticResource FeatureCardButtonStyle}"
                            Height="78"
                            Margin="6">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="14,0">
                            <Border Width="32"
                                    Height="32"
                                    CornerRadius="8"
                                    Background="#FFF7ED">
                                <Viewbox Margin="7">
                                    <TextBlock Text="⏱"/>
                                </Viewbox>
                            </Border>

                            <TextBlock Text="ЧАСЫ"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>

                    <Button Click="ReviewsButton_Click"
                            Style="{StaticResource FeatureCardButtonStyle}"
                            Height="78"
                            Margin="6">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="14,0">
                            <Border Width="32"
                                    Height="32"
                                    CornerRadius="8"
                                    Background="#FEF2F2">
                                <Viewbox Margin="7">
                                    <TextBlock Text="★"/>
                                </Viewbox>
                            </Border>

                            <TextBlock Text="ОТЗЫВЫ"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>