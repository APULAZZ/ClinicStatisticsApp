<Window x:Class="ClinicStatisticsApp.UI.BranchReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Филиальный отчет"
        Height="700"
        Width="920"
        MinHeight="700"
        MinWidth="920"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackgroundSoftBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Border Grid.Row="0"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="12"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource SoftBorderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="← Назад"
                            Width="82"
                            Height="30"
                            Margin="0"
                            FontSize="11"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BackButton_Click"/>
                    

                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="HeaderTextBlock"
                                   Style="{StaticResource TitleTextStyle}"
                                   FontSize="20"/>

                        <TextBlock x:Name="PeriodTextBlock"
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="0,4,0,0"
                                   FontSize="12"/>
                    </StackPanel>

                    <Border Grid.Column="3"
                            Background="{StaticResource SubtleAccentBrush}"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,5"
                            VerticalAlignment="Top">
                        <TextBlock Text=""
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Заполнить отчет -->
            <Border Grid.Row="2"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="12"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource SoftBorderBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Заполнить отчет"
                               Style="{StaticResource SectionTextStyle}"
                               FontSize="17"/>

                    <UniformGrid Grid.Row="2"
                                 Rows="2"
                                 Columns="2">

                        <Button Click="PerkButton_Click"
                                Style="{StaticResource FeatureCardButtonStyle}"
                                Height="74"
                                Margin="5">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="12,0">
                                <Border Width="30"
                                        Height="30"
                                        CornerRadius="8"
                                        Background="#EEF2FF">
                                    <Viewbox Margin="7">
                                        <TextBlock Text="📊"/>
                                    </Viewbox>
                                </Border>

                                <TextBlock Text="ПЕРК"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button Click="ProfiButton_Click"
                                Style="{StaticResource FeatureCardButtonStyle}"
                                Height="74"
                                Margin="5">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="12,0">
                                <Border Width="30"
                                        Height="30"
                                        CornerRadius="8"
                                        Background="#ECFDF5">
                                    <Viewbox Margin="7">
                                        <TextBlock Text="👥"/>
                                    </Viewbox>
                                </Border>

                                <TextBlock Text="ПРОФЫ"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button Click="HoursButton_Click"
                                Style="{StaticResource FeatureCardButtonStyle}"
                                Height="74"
                                Margin="5">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="12,0">
                                <Border Width="30"
                                        Height="30"
                                        CornerRadius="8"
                                        Background="#FFF7ED">
                                    <Viewbox Margin="7">
                                        <TextBlock Text="⏱"/>
                                    </Viewbox>
                                </Border>

                                <TextBlock Text="ЧАСЫ"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button Click="ReviewsButton_Click"
                                Style="{StaticResource FeatureCardButtonStyle}"
                                Height="74"
                                Margin="5">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="12,0">
                                <Border Width="30"
                                        Height="30"
                                        CornerRadius="8"
                                        Background="#FEF2F2">
                                    <Viewbox Margin="7">
                                        <TextBlock Text="★"/>
                                    </Viewbox>
                                </Border>

                                <TextBlock Text="ОТЗЫВЫ"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Сохранить и закрыть период -->
            <Border Grid.Row="4"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="12"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource SoftBorderBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Сохранить и закрыть период отчета"
                               Style="{StaticResource SectionTextStyle}"
                               FontSize="17"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Label Content="Год"/>
                            <ComboBox x:Name="YearComboBox"
                                      Width="160"
                                      Height="40"
                                      FontSize="12"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      SelectionChanged="PeriodChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Label Content="Месяц"/>
                            <ComboBox x:Name="MonthComboBox"
                                      Width="160"
                                      Height="40"
                                      FontSize="12"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      SelectionChanged="PeriodChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <Label Content="Статус"/>
                            <Border x:Name="StatusBadgeBorder"
                                    Width="160"
                                    Height="40"
                                    Background="{StaticResource PanelBackgroundBrush}"
                                    BorderBrush="{StaticResource SoftBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="StatusTextBlock"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="ClosePeriodButton"
                                Grid.Column="0"
                                Content="Закрыть период"
                                Width="140"
                                Height="34"
                                Margin="0"
                                FontSize="12"
                                Click="ClosePeriodButton_Click"/>

                        <Button x:Name="ReopenPeriodButton"
                                Grid.Column="2"
                                Content="Открыть период"
                                Width="140"
                                Height="34"
                                Margin="0"
                                FontSize="12"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ReopenPeriodButton_Click"/>

                        <Button x:Name="ExportExcelButton"
                                Grid.Column="4"
                                Content="Экспорт в Excel"
                                Width="150"
                                Height="34"
                                Margin="0"
                                FontSize="12"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ExportExcelButton_Click"/>

                        <Button x:Name="ExportPdfButton"
                                Grid.Column="6"
                                Content="Экспорт в PDF"
                                Width="140"
                                Height="34"
                                Margin="0"
                                FontSize="12"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ExportPdfButton_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>