<Window x:Class="ClinicStatisticsApp.UI.SummaryGeneralWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Статистика общая"
        Height="900"
        Width="1560"
        MinHeight="860"
        MinWidth="1380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackgroundSoftBrush}">

    <Window.Resources>
        <Style x:Key="CenteredCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LeftCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="10"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Статистика общая"
                               Style="{StaticResource TitleTextStyle}"
                               FontSize="18"/>
                    <TextBlock Text="Общая сводная статистика по филиалам и колл-центру."
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,2,0,0"
                               FontSize="11"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource SubtleAccentBrush}"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,4"
                        VerticalAlignment="Top">
                    <TextBlock Text="Сводный отчет"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}"
                Padding="10"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Label Content="Год"/>
                    <ComboBox x:Name="YearComboBox"
                              Width="130"
                              Height="30"
                              FontSize="12"
                              Style="{StaticResource ModernComboBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Label Content="Месяц"/>
                    <ComboBox x:Name="MonthComboBox"
                              Width="130"
                              Height="30"
                              FontSize="12"
                              Style="{StaticResource ModernComboBoxStyle}"/>
                </StackPanel>

                <Button Grid.Column="4"
                        Content="Построить"
                        Width="110"
                        Height="32"
                        Margin="0,24,0,0"
                        FontSize="12"
                        Click="BuildButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Style="{StaticResource CardBorderStyle}"
                Padding="8"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <TextBlock Text="ФИЛИАЛЫ"
                               Style="{StaticResource SectionTextStyle}"
                               FontSize="17"
                               Margin="0,0,0,8"/>

                    <DataGrid x:Name="BranchDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Margin="0,0,0,8"
                              FrozenColumnCount="2"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              RowHeight="26"
                              ColumnHeaderHeight="34"
                              FontSize="12"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#E5E7EB"
                              VerticalGridLinesBrush="#E5E7EB">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="6,2"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>

                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Padding" Value="8,5"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Height" Value="34"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="50" ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="Сотрудник" Binding="{Binding EmployeeFullName}" Width="220" ElementStyle="{StaticResource LeftCellStyle}"/>
                            <DataGridTextColumn Header="Явка" Binding="{Binding AttendanceTotal}" Width="75" ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="Неявка" Binding="{Binding AbsenceTotal}" Width="75" ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="Всего" Binding="{Binding GrandTotal}" Width="75" ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="ЦК" Binding="{Binding Ck}" Width="65" ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="Комфорт" Binding="{Binding Comfort}" Width="75" ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="Баграмяна" Binding="{Binding Bagramyana}" Width="90" ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="Детство" Binding="{Binding Detstvo}" Width="75" ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="Генделя" Binding="{Binding Gendelya}" Width="75" ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="Виктория" Binding="{Binding Viktoriya}" Width="75" ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="Альфа" Binding="{Binding Alfa}" Width="65" ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="Регион" Binding="{Binding Region}" Width="75" ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="Артиллерийская" Binding="{Binding Artilleriyskaya}" Width="105" ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="Сельма" Binding="{Binding Selma}" Width="65" ElementStyle="{StaticResource CenteredCellStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource SoftBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10"
                            Margin="0,0,0,14">
                        <TextBlock x:Name="BranchTotalsTextBlock"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="КОЛЛ-ЦЕНТР"
                               Style="{StaticResource SectionTextStyle}"
                               FontSize="17"
                               Margin="0,0,0,8"/>

                    <DataGrid x:Name="CallCenterDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Margin="0,0,0,8"
                              FrozenColumnCount="2"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              RowHeight="26"
                              ColumnHeaderHeight="34"
                              FontSize="12"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#E5E7EB"
                              VerticalGridLinesBrush="#E5E7EB">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="6,2"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>

                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Padding" Value="8,5"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Height" Value="34"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="50" ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="Сотрудник" Binding="{Binding EmployeeFullName}" Width="220" ElementStyle="{StaticResource LeftCellStyle}"/>
                            <DataGridTextColumn Header="Явка" Binding="{Binding AttendanceTotal}" Width="75" ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="Неявка" Binding="{Binding AbsenceTotal}" Width="75" ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="Всего" Binding="{Binding GrandTotal}" Width="75" ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="ЦК" Binding="{Binding Ck}" Width="65" ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="Комфорт" Binding="{Binding Comfort}" Width="75" ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="Баграмяна" Binding="{Binding Bagramyana}" Width="90" ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="Детство" Binding="{Binding Detstvo}" Width="75" ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="Генделя" Binding="{Binding Gendelya}" Width="75" ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="Виктория" Binding="{Binding Viktoriya}" Width="75" ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="Альфа" Binding="{Binding Alfa}" Width="65" ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="Регион" Binding="{Binding Region}" Width="75" ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="Артиллерийская" Binding="{Binding Artilleriyskaya}" Width="105" ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="Сельма" Binding="{Binding Selma}" Width="65" ElementStyle="{StaticResource CenteredCellStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource SoftBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10"
                            Margin="0,0,0,14">
                        <TextBlock x:Name="CallCenterTotalsTextBlock"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Border Background="{StaticResource SubtleAccentBrush}"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12">
                        <TextBlock x:Name="SystemTotalsTextBlock"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>