<Window x:Class="ClinicStatisticsApp.UI.SummaryGeneralWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Статистика общая"
        Height="900"
        Width="1560"
        MinHeight="860"
        MinWidth="1380"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Статистика общая"
                               Style="{StaticResource TitleTextStyle}"
                               FontSize="18"/>
                    <TextBlock Text="Общая сводная статистика по филиалам и колл-центру."
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,2,0,0"
                               FontSize="11"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource PrimaryLightBrush}"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,4"
                        VerticalAlignment="Top">
                    <TextBlock Text="Сводный отчет"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Label Content="Год"/>
                    <ComboBox x:Name="YearComboBox"
                              Width="130"
                              Height="30"
                              FontSize="12"
                              Style="{StaticResource ModernComboBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Label Content="Месяц"/>
                    <ComboBox x:Name="MonthComboBox"
                              Width="130"
                              Height="30"
                              FontSize="12"
                              Style="{StaticResource ModernComboBoxStyle}"/>
                </StackPanel>

                <Button Grid.Column="4"
                        Content="Построить"
                        Width="110"
                        Height="32"
                        Margin="0,24,0,0"
                        FontSize="12"
                        Click="BuildButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <TextBlock Text="ФИЛИАЛЫ"
                               Style="{StaticResource SectionTextStyle}"
                               FontSize="17"
                               Margin="0,0,0,8"/>

                    <DataGrid x:Name="BranchDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Margin="0,0,0,8"
                              FrozenColumnCount="2"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              RowHeight="26"
                              ColumnHeaderHeight="37"
                              FontSize="12"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#E5E7EB"
                              VerticalGridLinesBrush="#E5E7EB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="50"/>
                            <DataGridTextColumn Header="Сотрудник" Binding="{Binding EmployeeFullName}" Width="220"/>
                            <DataGridTextColumn Header="Явка" Binding="{Binding AttendanceTotal}" Width="75"/>
                            <DataGridTextColumn Header="Неявка" Binding="{Binding AbsenceTotal}" Width="75"/>
                            <DataGridTextColumn Header="Всего" Binding="{Binding GrandTotal}" Width="75"/>
                            <DataGridTextColumn Header="ЦК" Binding="{Binding Ck}" Width="65"/>
                            <DataGridTextColumn Header="Комфорт" Binding="{Binding Comfort}" Width="75"/>
                            <DataGridTextColumn Header="Баграмяна" Binding="{Binding Bagramyana}" Width="90"/>
                            <DataGridTextColumn Header="Детство" Binding="{Binding Detstvo}" Width="75"/>
                            <DataGridTextColumn Header="Генделя" Binding="{Binding Gendelya}" Width="75"/>
                            <DataGridTextColumn Header="Виктория" Binding="{Binding Viktoriya}" Width="75"/>
                            <DataGridTextColumn Header="Альфа" Binding="{Binding Alfa}" Width="65"/>
                            <DataGridTextColumn Header="Регион" Binding="{Binding Region}" Width="75"/>
                            <DataGridTextColumn Header="Артиллерийская" Binding="{Binding Artilleriyskaya}" Width="105"/>
                            <DataGridTextColumn Header="Сельма" Binding="{Binding Selma}" Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Background="{StaticResource MutedBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrushCustom}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10"
                            Margin="0,0,0,14">
                        <TextBlock x:Name="BranchTotalsTextBlock"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="КОЛЛ-ЦЕНТР"
                               Style="{StaticResource SectionTextStyle}"
                               FontSize="17"
                               Margin="0,0,0,8"/>

                    <DataGrid x:Name="CallCenterDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Margin="0,0,0,8"
                              FrozenColumnCount="2"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              RowHeight="26"
                              ColumnHeaderHeight="37"
                              FontSize="12"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#E5E7EB"
                              VerticalGridLinesBrush="#E5E7EB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="50"/>
                            <DataGridTextColumn Header="Сотрудник" Binding="{Binding EmployeeFullName}" Width="220"/>
                            <DataGridTextColumn Header="Явка" Binding="{Binding AttendanceTotal}" Width="75"/>
                            <DataGridTextColumn Header="Неявка" Binding="{Binding AbsenceTotal}" Width="75"/>
                            <DataGridTextColumn Header="Всего" Binding="{Binding GrandTotal}" Width="75"/>
                            <DataGridTextColumn Header="ЦК" Binding="{Binding Ck}" Width="65"/>
                            <DataGridTextColumn Header="Комфорт" Binding="{Binding Comfort}" Width="75"/>
                            <DataGridTextColumn Header="Баграмяна" Binding="{Binding Bagramyana}" Width="90"/>
                            <DataGridTextColumn Header="Детство" Binding="{Binding Detstvo}" Width="75"/>
                            <DataGridTextColumn Header="Генделя" Binding="{Binding Gendelya}" Width="75"/>
                            <DataGridTextColumn Header="Виктория" Binding="{Binding Viktoriya}" Width="75"/>
                            <DataGridTextColumn Header="Альфа" Binding="{Binding Alfa}" Width="65"/>
                            <DataGridTextColumn Header="Регион" Binding="{Binding Region}" Width="75"/>
                            <DataGridTextColumn Header="Артиллерийская" Binding="{Binding Artilleriyskaya}" Width="105"/>
                            <DataGridTextColumn Header="Сельма" Binding="{Binding Selma}" Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Background="{StaticResource MutedBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrushCustom}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10"
                            Margin="0,0,0,14">
                        <TextBlock x:Name="CallCenterTotalsTextBlock"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Border Background="{StaticResource PrimaryLightBrush}"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12">
                        <TextBlock x:Name="SystemTotalsTextBlock"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>