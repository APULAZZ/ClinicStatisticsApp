<Window x:Class="ClinicStatisticsApp.UI.SummaryGeneralWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Статистика общая"
        Height="800"
        Width="1450"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Год:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="YearComboBox" Width="100" Margin="0,0,20,0"/>

            <TextBlock Text="Месяц:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="MonthComboBox" Width="140" Margin="0,0,20,0"/>

            <Button Content="Построить" Width="140" Height="34" Click="BuildButton_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="ФИЛИАЛЫ"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <DataGrid x:Name="BranchDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Margin="0,0,0,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="50"/>
                        <DataGridTextColumn Header="Сотрудник" Binding="{Binding EmployeeFullName}" Width="220"/>
                        <DataGridTextColumn Header="Явка" Binding="{Binding AttendanceTotal}" Width="80"/>
                        <DataGridTextColumn Header="Неявка" Binding="{Binding AbsenceTotal}" Width="80"/>
                        <DataGridTextColumn Header="Всего" Binding="{Binding GrandTotal}" Width="80"/>
                        <DataGridTextColumn Header="ЦК" Binding="{Binding Ck}" Width="70"/>
                        <DataGridTextColumn Header="Комфорт" Binding="{Binding Comfort}" Width="80"/>
                        <DataGridTextColumn Header="Баграмяна" Binding="{Binding Bagramyana}" Width="90"/>
                        <DataGridTextColumn Header="Детство" Binding="{Binding Detstvo}" Width="80"/>
                        <DataGridTextColumn Header="Генделя" Binding="{Binding Gendelya}" Width="80"/>
                        <DataGridTextColumn Header="Виктория" Binding="{Binding Viktoriya}" Width="80"/>
                        <DataGridTextColumn Header="Альфа" Binding="{Binding Alfa}" Width="70"/>
                        <DataGridTextColumn Header="Регион" Binding="{Binding Region}" Width="80"/>
                        <DataGridTextColumn Header="Артиллерийская" Binding="{Binding Artilleriyskaya}" Width="110"/>
                        <DataGridTextColumn Header="Сельма" Binding="{Binding Selma}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="BranchTotalsTextBlock"
                           Margin="0,0,0,20"
                           FontSize="15"
                           FontWeight="SemiBold"/>

                <TextBlock Text="КОЛЛ-ЦЕНТР"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <DataGrid x:Name="CallCenterDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Margin="0,0,0,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="50"/>
                        <DataGridTextColumn Header="Сотрудник" Binding="{Binding EmployeeFullName}" Width="220"/>
                        <DataGridTextColumn Header="Явка" Binding="{Binding AttendanceTotal}" Width="80"/>
                        <DataGridTextColumn Header="Неявка" Binding="{Binding AbsenceTotal}" Width="80"/>
                        <DataGridTextColumn Header="Всего" Binding="{Binding GrandTotal}" Width="80"/>
                        <DataGridTextColumn Header="ЦК" Binding="{Binding Ck}" Width="70"/>
                        <DataGridTextColumn Header="Комфорт" Binding="{Binding Comfort}" Width="80"/>
                        <DataGridTextColumn Header="Баграмяна" Binding="{Binding Bagramyana}" Width="90"/>
                        <DataGridTextColumn Header="Детство" Binding="{Binding Detstvo}" Width="80"/>
                        <DataGridTextColumn Header="Генделя" Binding="{Binding Gendelya}" Width="80"/>
                        <DataGridTextColumn Header="Виктория" Binding="{Binding Viktoriya}" Width="80"/>
                        <DataGridTextColumn Header="Альфа" Binding="{Binding Alfa}" Width="70"/>
                        <DataGridTextColumn Header="Регион" Binding="{Binding Region}" Width="80"/>
                        <DataGridTextColumn Header="Артиллерийская" Binding="{Binding Artilleriyskaya}" Width="110"/>
                        <DataGridTextColumn Header="Сельма" Binding="{Binding Selma}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="CallCenterTotalsTextBlock"
                           Margin="0,0,0,20"
                           FontSize="15"
                           FontWeight="SemiBold"/>

                <TextBlock x:Name="SystemTotalsTextBlock"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#1E4E8C"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>