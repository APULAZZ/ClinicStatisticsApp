<Window x:Class="ClinicStatisticsApp.UI.ComparativeProfiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сравнительная статистика ПРОФЫ"
        Height="900"
        Width="1580"
        MinHeight="900"
        MinWidth="1400"
        WindowStartupLocation="CenterOwner">

	<Grid Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="18"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="18"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Шапка -->
		<Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<StackPanel>
					<TextBlock Text="Сравнительная статистика ПРОФЫ"
                               Style="{StaticResource TitleTextStyle}"/>

					<TextBlock Text="Сравнение основного года с выбранными дополнительными годами по филиалам."
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,8,0,0"/>
				</StackPanel>

				<Border Grid.Column="1"
                        Background="{StaticResource PrimaryLightBrush}"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,8"
                        VerticalAlignment="Top">
					<TextBlock Text="Сравнительный анализ"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"/>
				</Border>
			</Grid>
		</Border>

		<!-- Параметры -->
		<Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="18"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="18"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<TextBlock Text="Параметры построения"
                           Style="{StaticResource SectionTextStyle}"/>

				<!-- Верхняя строка -->
				<Grid Grid.Row="2">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="180"/>
						<ColumnDefinition Width="12"/>
						<ColumnDefinition Width="140"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0">
						<Label Content="Основной год"/>
						<ComboBox x:Name="MainYearComboBox"
                                  Width="180"
                                  Height="40"
                                  Style="{StaticResource ModernComboBoxStyle}"/>
					</StackPanel>

					<Button Grid.Column="2"
                            Content="Построить"
                            Width="140"
                            Height="42"
                            Margin="0,30,0,0"
                            Click="BuildButton_Click"/>
				</Grid>

				<!-- Дополнительные годы -->
				<StackPanel Grid.Row="4">
					<TextBlock Text="Дополнительные годы для сравнения"
                               Style="{StaticResource SectionTextStyle}"
                               FontSize="16"/>

					<Border Margin="0,10,0,0"
                            Background="{StaticResource MutedBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrushCustom}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14">
						<WrapPanel x:Name="YearsPanel"/>
					</Border>
				</StackPanel>
			</Grid>
		</Border>

		<!-- Таблица -->
		<Border Grid.Row="4"
                Style="{StaticResource CardBorderStyle}"
                Padding="18">
			<DataGrid x:Name="ComparativeDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      FrozenColumnCount="1"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      RowHeight="34"/>
		</Border>
	</Grid>
</Window>