<Window x:Class="ClinicStatisticsApp.UI.ComparativeProfiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сравнительная статистика ПРОФЫ"
        Height="800"
        Width="1500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Основной год:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="MainYearComboBox" Width="100" Margin="0,0,20,0"/>
                <Button Content="Построить" Width="140" Height="34" Click="BuildButton_Click"/>
            </StackPanel>

            <StackPanel Margin="0,15,0,0">
                <TextBlock Text="Дополнительные годы для сравнения:" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <WrapPanel x:Name="YearsPanel"/>
            </StackPanel>
        </StackPanel>

        <DataGrid Grid.Row="2"
                  x:Name="ComparativeDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"/>
    </Grid>
</Window>