<UserControl x:Class="ClinicStatisticsApp.UI.ComparativeProfiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource PageBackgroundSoftBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="10"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="← Назад"
                        Width="82"
                        Height="30"
                        Margin="0"
                        FontSize="11"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BackButton_Click"/>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Сравнительная статистика ПРОФЫ"
                               Style="{StaticResource TitleTextStyle}"
                               FontSize="18"/>
                    <TextBlock Text="Сравнение основного года с выбранными годами по филиалам."
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,2,0,0"
                               FontSize="11"/>
                </StackPanel>

                <Border Grid.Column="3"
                        Background="{StaticResource SubtleAccentBrush}"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,4"
                        VerticalAlignment="Top">
                    <TextBlock Text="Сравнительный анализ"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}"
                Padding="10"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Основной год"/>
                        <ComboBox x:Name="MainYearComboBox"
                                  Width="160"
                                  Height="30"
                                  FontSize="12"
                                  Style="{StaticResource ModernComboBoxStyle}"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="Построить"
                            Width="110"
                            Height="32"
                            Margin="0,24,0,0"
                            FontSize="12"
                            Click="BuildButton_Click"/>
                </Grid>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Дополнительные годы"
                               Style="{StaticResource SectionTextStyle}"
                               FontSize="15"/>

                    <Border Margin="0,6,0,0"
                            Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource SoftBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10">
                        <WrapPanel x:Name="YearsPanel"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Style="{StaticResource CardBorderStyle}"
                Padding="8"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}">
            <DataGrid x:Name="ComparativeDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      FrozenColumnCount="1"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      RowHeight="26"
                      ColumnHeaderHeight="32"
                      FontSize="12"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#E5E7EB"
                      VerticalGridLinesBrush="#E5E7EB"/>
        </Border>
    </Grid>
</UserControl>
