<UserControl x:Class="ClinicStatisticsApp.UI.SummaryBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource PageBackgroundSoftBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Border Grid.Row="0"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="12"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource SoftBorderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="← Назад"
                            Width="82"
                            Height="30"
                            Margin="0"
                            FontSize="11"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BackButton_Click"/>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Сводная книга"
                                   Style="{StaticResource TitleTextStyle}"
                                   FontSize="20"/>

                        <TextBlock Text="Откройте нужный сводный лист или выполните экспорт книги за выбранный период."
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="0,4,0,0"
                                   FontSize="12"/>
                    </StackPanel>

                    <Border Grid.Column="3"
                            Background="{StaticResource SubtleAccentBrush}"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,5"
                            VerticalAlignment="Top">
                        <TextBlock Text="Сводные отчеты"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Сводные листы -->
            <Border Grid.Row="2"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="12"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource SoftBorderBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Сводные листы"
                               Style="{StaticResource SectionTextStyle}"
                               FontSize="17"/>

                    <UniformGrid Grid.Row="2"
                                 Rows="4"
                                 Columns="2">

                        <Button Click="SummaryGeneralButton_Click"
                                Style="{StaticResource FeatureCardButtonStyle}"
                                Height="74"
                                Margin="5">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="12,0">
                                <Border Width="30"
                                        Height="30"
                                        CornerRadius="8"
                                        Background="#EEF2FF">
                                    <Viewbox Margin="7">
                                        <TextBlock Text="📘"/>
                                    </Viewbox>
                                </Border>

                                <TextBlock Text="Статистика общая"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button Click="SummaryProfoButton_Click"
                                Style="{StaticResource FeatureCardButtonStyle}"
                                Height="74"
                                Margin="5">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="12,0">
                                <Border Width="30"
                                        Height="30"
                                        CornerRadius="8"
                                        Background="#ECFDF5">
                                    <Viewbox Margin="7">
                                        <TextBlock Text="🩺"/>
                                    </Viewbox>
                                </Border>

                                <TextBlock Text="Проф. осмотры"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button Click="SummaryAdminButton_Click"
                                Style="{StaticResource FeatureCardButtonStyle}"
                                Height="74"
                                Margin="5">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="12,0">
                                <Border Width="30"
                                        Height="30"
                                        CornerRadius="8"
                                        Background="#FFF7ED">
                                    <Viewbox Margin="7">
                                        <TextBlock Text="👤"/>
                                    </Viewbox>
                                </Border>

                                <TextBlock Text="Администраторы"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button Click="SummaryProDoctorButton_Click"
                                Style="{StaticResource FeatureCardButtonStyle}"
                                Height="74"
                                Margin="5">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="12,0">
                                <Border Width="30"
                                        Height="30"
                                        CornerRadius="8"
                                        Background="#FEF2F2">
                                    <Viewbox Margin="7">
                                        <TextBlock Text="★"/>
                                    </Viewbox>
                                </Border>

                                <TextBlock Text="Отзывы ПроДокторов"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button Click="DynamicsButton_Click"
                                Style="{StaticResource FeatureCardButtonStyle}"
                                Height="74"
                                Margin="5">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="12,0">
                                <Border Width="30"
                                        Height="30"
                                        CornerRadius="8"
                                        Background="#F5F3FF">
                                    <Viewbox Margin="7">
                                        <TextBlock Text="📈"/>
                                    </Viewbox>
                                </Border>

                                <TextBlock Text="Динамика"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button Click="ComparativePerkButton_Click"
                                Style="{StaticResource FeatureCardButtonStyle}"
                                Height="74"
                                Margin="5">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="12,0">
                                <Border Width="30"
                                        Height="30"
                                        CornerRadius="8"
                                        Background="#EEF2FF">
                                    <Viewbox Margin="7">
                                        <TextBlock Text="📊"/>
                                    </Viewbox>
                                </Border>

                                <TextBlock Text="Сравнительная ПЕРК"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button Click="ComparativeProfiButton_Click"
                                Style="{StaticResource FeatureCardButtonStyle}"
                                Height="74"
                                Margin="5">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="12,0">
                                <Border Width="30"
                                        Height="30"
                                        CornerRadius="8"
                                        Background="#ECFDF5">
                                    <Viewbox Margin="7">
                                        <TextBlock Text="👥"/>
                                    </Viewbox>
                                </Border>

                                <TextBlock Text="Сравнительная ПРОФЫ"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button Click="AbsolutePrimaryButton_Click"
                                Style="{StaticResource FeatureCardButtonStyle}"
                                Height="74"
                                Margin="5">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="12,0">
                                <Border Width="30"
                                        Height="30"
                                        CornerRadius="8"
                                        Background="#FFF7ED">
                                    <Viewbox Margin="7">
                                        <TextBlock Text="🧮"/>
                                    </Viewbox>
                                </Border>

                                <TextBlock Text="Абсолютные первичные"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Параметры экспорта -->
            <Border Grid.Row="4"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="12"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource SoftBorderBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Параметры экспорта"
                               Style="{StaticResource SectionTextStyle}"
                               FontSize="17"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="145"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Label Content="Год"/>
                            <ComboBox x:Name="ExportYearComboBox"
                                      Width="140"
                                      Height="30"
                                      FontSize="12"
                                      Style="{StaticResource ModernComboBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Label Content="Месяц"/>
                            <ComboBox x:Name="ExportMonthComboBox"
                                      Width="140"
                                      Height="30"
                                      FontSize="12"
                                      Style="{StaticResource ModernComboBoxStyle}"/>
                        </StackPanel>

                        <Button Grid.Column="4"
                                Content="Экспорт в Excel"
                                Width="145"
                                Height="34"
                                Margin="0,24,0,0"
                                FontSize="12"
                                Click="ExportExcelButton_Click"/>

                        <Button Grid.Column="6"
                                Content="Экспорт в PDF"
                                Width="140"
                                Height="34"
                                Margin="0,24,0,0"
                                FontSize="12"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ExportPdfButton_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
