<Window x:Class="ClinicStatisticsApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система статистики"
        Height="560"
        Width="1040"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="88"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource BorderBrushCustom}"
                BorderThickness="0,0,0,1"
                Padding="28,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Система статистики клиники"
                               Style="{StaticResource TitleTextStyle}"/>
                    <TextBlock x:Name="UserInfoTextBlock"
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource PrimaryLightBrush}"
                        CornerRadius="14"
                        Padding="14,8"
                        VerticalAlignment="Center"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1">
                    <TextBlock Text="Панель управления"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- Основная часть -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель -->
            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Навигация"
                               Style="{StaticResource SectionTextStyle}"
                               Margin="0,0,0,18"/>

                    <Button x:Name="ReportsButton"
        Content="Филиальный отчет"
        Style="{StaticResource SidebarButtonStyle}"
        Click="ReportsButton_Click"/>

                    <Button x:Name="NaradButton"
        Content="Наряд"
        Style="{StaticResource SidebarButtonStyle}"
        Click="NaradButton_Click"/>

                    <Button x:Name="SummaryButton"
        Content="Сводная книга"
        Style="{StaticResource SidebarButtonStyle}"
        Click="SummaryButton_Click"/>

                    <Button x:Name="EmployeesButton"
        Content="Сотрудники"
        Style="{StaticResource SidebarButtonStyle}"
        Click="EmployeesButton_Click"/>

                    <Button x:Name="UsersButton"
        Content="Пользователи"
        Style="{StaticResource SidebarButtonStyle}"
        Click="UsersButton_Click"/>

                    <Border Margin="0,18,0,0"
                            Padding="12"
                            CornerRadius="12"
                            Background="{StaticResource MutedBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrushCustom}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Подсказка"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Выберите нужный раздел в меню слева для просмотра статистики и управления данными."
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource BodyTextStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Правая часть -->
            <Border Grid.Column="2"
                    Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Рабочая область"
                               Style="{StaticResource TitleTextStyle}"/>

                    <TextBlock Grid.Row="2"
                               x:Name="WelcomeTextBlock"
                               Style="{StaticResource BodyTextStyle}"
                               FontSize="15"
                               TextWrapping="Wrap"/>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource MutedBackgroundBrush}"
                                CornerRadius="14"
                                Padding="18"
                                BorderBrush="{StaticResource BorderBrushCustom}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Быстрый доступ"
                                           Style="{StaticResource SectionTextStyle}"
                                           FontSize="16"/>
                                <TextBlock Text="Открывайте основные разделы системы через меню слева."
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource BodyTextStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="14"
                                Padding="18"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Состояние системы"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryDarkBrush}"/>
                                <TextBlock Text="Интерфейс готов к работе. Выберите раздел для продолжения."
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource PrimaryDarkBrush}"
                                           FontSize="14"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>