<Window x:Class="ClinicStatisticsApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система статистики"
        Height="635"
        Width="1040"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundSoftBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Статистика СК ЭДКАР"
                               Style="{StaticResource TitleTextStyle}"
                               FontSize="24"/>
                    <TextBlock x:Name="UserInfoTextBlock"
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,4,0,0"
                               FontSize="13"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource SubtleAccentBrush}"
                        CornerRadius="12"
                        Padding="12,6"
                        VerticalAlignment="Center"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1">
                    <TextBlock Text="Панель управления"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- Основная часть -->
        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель -->
            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource SoftBorderBrush}"
                    Padding="14">
                <StackPanel>
                    <TextBlock Text="Навигация"
                               Style="{StaticResource SectionTextStyle}"
                               FontSize="18"
                               Margin="0,0,0,14"/>

                    <Button x:Name="ReportsButton"
                            Content="Филиальный отчет"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="ReportsButton_Click"/>

                    <Button x:Name="NaradButton"
                            Content="Наряд"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="NaradButton_Click"/>

                    <Button x:Name="SummaryButton"
                            Content="Сводная книга"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="SummaryButton_Click"/>

                    <Button x:Name="EmployeesButton"
                            Content="Сотрудники"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="EmployeesButton_Click"/>

                    <Button x:Name="UsersButton"
                            Content="Пользователи"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="UsersButton_Click"/>

                    <Border Margin="0,16,0,0"
                            Padding="10"
                            CornerRadius="10"
                            Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource SoftBorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Подсказка"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13"/>
                            <TextBlock Text="Выберите нужный раздел в меню слева для перехода к отчетам, справочникам и сводной аналитике."
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource BodyTextStyle}"
                                       FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Правая часть -->
            <Border Grid.Column="2"
                    Style="{StaticResource CardBorderStyle}"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource SoftBorderBrush}"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Рабочая область"
                               Style="{StaticResource TitleTextStyle}"
                               FontSize="22"/>

                    <TextBlock Grid.Row="2"
                               x:Name="WelcomeTextBlock"
                               Style="{StaticResource BodyTextStyle}"
                               FontSize="14"
                               TextWrapping="Wrap"/>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource PanelBackgroundBrush}"
                                CornerRadius="12"
                                Padding="14"
                                BorderBrush="{StaticResource SoftBorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Быстрый доступ"
                                           Style="{StaticResource SectionTextStyle}"
                                           FontSize="15"/>
                                <TextBlock Text="Открывайте основные разделы системы через навигацию слева."
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource BodyTextStyle}"
                                           FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{StaticResource SubtleAccentBrush}"
                                CornerRadius="12"
                                Padding="14"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Состояние системы"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryDarkBrush}"/>
                                <TextBlock Text="Интерфейс готов к работе. Выберите раздел для продолжения."
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource PrimaryDarkBrush}"
                                           FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>