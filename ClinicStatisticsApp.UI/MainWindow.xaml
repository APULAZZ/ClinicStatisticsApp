<Window x:Class="ClinicStatisticsApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система статистики" Height="780" Width="1280"
        MinHeight="620" MinWidth="1024" WindowStartupLocation="CenterScreen"
        WindowState="Maximized" Background="#F6F8FC">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#243554"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#30466E"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#15233D">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="26,28,16,22">
                    <TextBlock Text="MANGO" Foreground="#60A5FA" FontWeight="Bold" FontSize="12"/>
                    <TextBlock Text="Статистика" Foreground="White" FontWeight="SemiBold" FontSize="22" Margin="0,4,0,0"/>
                    <TextBlock x:Name="NavigationTitleTextBlock" Text="Клиники и коллцентр" Foreground="#94A3B8" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <Button x:Name="ReportsButton" Content="Филиальный отчёт" Style="{StaticResource NavButton}" Click="ReportsButton_Click"/>
                    <Button x:Name="NaradButton" Content="Наряд" Style="{StaticResource NavButton}" Click="NaradButton_Click"/>
                    <Button x:Name="SummaryButton" Content="Сводная книга" Style="{StaticResource NavButton}" Click="SummaryButton_Click"/>
                    <Button x:Name="EmployeesButton" Content="Сотрудники" Style="{StaticResource NavButton}" Click="EmployeesButton_Click"/>
                    <Button x:Name="UsersButton" Content="Пользователи" Style="{StaticResource NavButton}" Click="UsersButton_Click"/>
                    <Button x:Name="ChatButton" Content="Чат" Style="{StaticResource NavButton}" Click="ChatButton_Click"/>

                    <Button x:Name="CallCenterDashboardButton" Content="Обзор" Style="{StaticResource NavButton}" Visibility="Collapsed" Click="CallCenterDashboardButton_Click"/>
                    <Button x:Name="CallCenterJournalButton" Content="Журнал звонков" Style="{StaticResource NavButton}" Visibility="Collapsed" Click="CallCenterJournalButton_Click"/>
                    <Button x:Name="CallCenterEmployeeStatisticsButton" Content="Статистика сотрудников" Style="{StaticResource NavButton}" Visibility="Collapsed" Click="CallCenterEmployeeStatisticsButton_Click"/>
                    <Button x:Name="CallCenterGroupStatisticsButton" Content="Статистика групп" Style="{StaticResource NavButton}" Visibility="Collapsed" Click="CallCenterGroupStatisticsButton_Click"/>
                    <Button x:Name="CallCenterImportButton" Content="Импорт из Mango" Style="{StaticResource NavButton}" Visibility="Collapsed" Click="CallCenterImportButton_Click"/>
                    <Button x:Name="CallCenterGoogleTablesButton" Content="Гугл-таблички" Style="{StaticResource NavButton}" Visibility="Collapsed" Click="CallCenterGoogleTablesButton_Click"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,20">
                    <Separator Background="#2B3B58" Margin="20,8"/>
                    <Button x:Name="CallCenterSettingsButton" Content="Настройки API" Style="{StaticResource NavButton}" Visibility="Collapsed" Click="CallCenterSettingsButton_Click"/>
                    <TextBlock Text="Система статистики" Foreground="#94A3B8" FontSize="12" Margin="26,8,10,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>
            <Border x:Name="BusyOverlay" Grid.RowSpan="3" Background="#990F172A" Visibility="Collapsed" Panel.ZIndex="10">
                <Border Background="White" CornerRadius="10" Padding="26" Width="360" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="BusyMessageText" FontSize="16" FontWeight="SemiBold" Foreground="#172033" TextAlignment="Center" TextWrapping="Wrap"/>
                        <ProgressBar IsIndeterminate="True" Height="8" Margin="0,18,0,0"/>
                    </StackPanel>
                </Border>
            </Border>

            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid Margin="30,0">
                    <StackPanel x:Name="MedicalHeaderPanel" VerticalAlignment="Center">
                        <TextBlock Text="Система статистики" FontSize="20" FontWeight="SemiBold" Foreground="#172033"/>
                        <TextBlock x:Name="UserInfoTextBlock" Foreground="#64748B" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="CallCenterPageTitleTextBlock" Visibility="Collapsed" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="#172033"/>
                    <TextBlock Text="Mango Office" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#64748B"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="30,24">
                <Grid x:Name="StartContentGrid">
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="28">
                        <StackPanel>
                            <TextBlock Text="Рабочая область" FontSize="22" FontWeight="SemiBold" Foreground="#172033"/>
                            <TextBlock x:Name="WelcomeTextBlock" Foreground="#64748B" FontSize="14" TextWrapping="Wrap" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <ContentControl x:Name="CallCenterContentControl" Visibility="Collapsed"/>
            </Grid>

            <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <TextBlock Text="Готово к работе" Margin="30,0" VerticalAlignment="Center" Foreground="#64748B" FontSize="12"/>
            </Border>
        </Grid>
    </Grid>
</Window>
