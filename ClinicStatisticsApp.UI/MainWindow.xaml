<Window x:Class="ClinicStatisticsApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система статистики"
        Height="500"
        Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2D2D30" Padding="20">
            <DockPanel>
                <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                    <TextBlock Text="Система статистики клиники"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="UserInfoTextBlock"
                               Foreground="#DDDDDD"
                               FontSize="14"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    Padding="15">
                <StackPanel>
                    <TextBlock Text="Меню"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,15"/>

                    <Button x:Name="ReportsButton"
                            Content="Филиальный отчет"
                            Height="40"
                            Margin="0,0,0,10"
                            Click="ReportsButton_Click"/>

                    <Button x:Name="NaradButton"
                            Content="Наряд"
                            Height="40"
                            Margin="0,0,0,10"
                            Click="NaradButton_Click"/>

                    <Button x:Name="SummaryButton"
                            Content="Сводная книга"
                            Height="40"
                            Margin="0,0,0,10"
                            Click="SummaryButton_Click"/>

                    <Button x:Name="EmployeesButton"
                            Content="Сотрудники"
                            Height="40"
                            Margin="0,0,0,10"
                            Click="EmployeesButton_Click"/>

                    <Button x:Name="UsersButton"
                            Content="Пользователи"
                            Height="40"
                            Margin="0,0,0,10"
                            Click="UsersButton_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="10"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Рабочая область"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,0,0,15"/>

                    <TextBlock x:Name="WelcomeTextBlock"
                               FontSize="16"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>