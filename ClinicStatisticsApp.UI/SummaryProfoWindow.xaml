<Window x:Class="ClinicStatisticsApp.UI.SummaryProfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Статистика проф. осмотров"
        Height="900"
        Width="1480"
        MinHeight="860"
        MinWidth="1320"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackgroundSoftBrush}">

    <Window.Resources>
        <Style x:Key="CenteredCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LeftCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="10"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="← Назад"
                        Width="82"
                        Height="30"
                        Margin="0"
                        FontSize="11"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BackButton_Click"/>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Статистика проф. осмотров"
                               Style="{StaticResource TitleTextStyle}"
                               FontSize="18"/>
                    <TextBlock Text="Сводка по профосмотрам, категориям, ставкам и премии."
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,2,0,0"
                               FontSize="11"/>
                </StackPanel>

                <Border Grid.Column="3"
                        Background="{StaticResource SubtleAccentBrush}"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,4"
                        VerticalAlignment="Top">
                    <TextBlock Text="Сводный отчет"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- Параметры -->
        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}"
                Padding="10"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Label Content="Год"/>
                    <ComboBox x:Name="YearComboBox"
                              Width="130"
                              Height="30"
                              FontSize="12"
                              Style="{StaticResource ModernComboBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Label Content="Месяц"/>
                    <ComboBox x:Name="MonthComboBox"
                              Width="130"
                              Height="30"
                              FontSize="12"
                              Style="{StaticResource ModernComboBoxStyle}"/>
                </StackPanel>

                <Button Grid.Column="4"
                        Content="Загрузить"
                        Width="110"
                        Height="32"
                        Margin="0,24,0,0"
                        FontSize="12"
                        Click="LoadButton_Click"/>

                <Button Grid.Column="6"
                        Content="Сохранить"
                        Width="110"
                        Height="32"
                        Margin="0,24,0,0"
                        FontSize="12"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="SaveButton_Click"/>
            </Grid>
        </Border>

        <!-- Таблица -->
        <Border Grid.Row="4"
                Style="{StaticResource CardBorderStyle}"
                Padding="8"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}">
            <DataGrid x:Name="ProfoDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      FrozenColumnCount="2"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      RowHeight="26"
                      ColumnHeaderHeight="34"
                      FontSize="12"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#E5E7EB"
                      VerticalGridLinesBrush="#E5E7EB">
                <DataGrid.Resources>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="6,2"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>

                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Height" Value="34"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="BorderBrush" Value="#D1D5DB"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Филиал"
                                        Binding="{Binding BranchName}"
                                        Width="140"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource LeftCellStyle}"/>

                    <DataGridTextColumn Header="Администратор"
                                        Binding="{Binding EmployeeFullName}"
                                        Width="220"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource LeftCellStyle}"/>

                    <DataGridComboBoxColumn Header="Ставка"
                                            Width="90"
                                            SelectedItemBinding="{Binding Rate, UpdateSourceTrigger=PropertyChanged}"
                                            x:Name="RateColumn"/>

                    <DataGridTextColumn Header="Пригласили"
                                        Binding="{Binding InvitedCount}"
                                        Width="100"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CenteredCellStyle}"/>

                    <DataGridTextColumn Header="Записались"
                                        Binding="{Binding BookedCount}"
                                        Width="100"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CenteredCellStyle}"/>

                    <DataGridTextColumn Header="Пришли"
                                        Binding="{Binding ArrivedCount}"
                                        Width="100"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CenteredCellStyle}"/>

                    <DataGridComboBoxColumn Header="Категория"
                                            Width="180"
                                            SelectedValueBinding="{Binding ProfoCategoryId, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Id"
                                            DisplayMemberPath="Name"
                                            x:Name="CategoryColumn"/>

                    <DataGridTextColumn Header="Премия"
                                        Binding="{Binding Premium}"
                                        Width="110"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CenteredCellStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Итоги -->
        <Border Grid.Row="6"
                Style="{StaticResource CardBorderStyle}"
                Padding="8"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}">
            <TextBlock x:Name="TotalsTextBlock"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryDarkBrush}"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Конверсия -->
        <Border Grid.Row="8"
                Style="{StaticResource CardBorderStyle}"
                Padding="8"
                Background="{StaticResource SubtleAccentBrush}"
                BorderBrush="#BFDBFE">
            <TextBlock x:Name="ConversionTextBlock"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryDarkBrush}"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>