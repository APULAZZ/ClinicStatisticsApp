<Window x:Class="ClinicStatisticsApp.UI.SummaryProfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Статистика проф. осмотров"
        Height="940"
        Width="1480"
        MinHeight="900"
        MinWidth="1320"
        WindowStartupLocation="CenterOwner">

	<Grid Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="18"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="18"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="18"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="18"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Шапка -->
		<Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<StackPanel>
					<TextBlock Text="Статистика проф. осмотров"
                               Style="{StaticResource TitleTextStyle}"/>

					<TextBlock Text="Сводная статистика по профосмотрам, категориям, ставкам и итоговой премии за выбранный период."
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,8,0,0"/>
				</StackPanel>

				<Border Grid.Column="1"
                        Background="{StaticResource PrimaryLightBrush}"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,8"
                        VerticalAlignment="Top">
					<TextBlock Text="Сводный отчет"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"/>
				</Border>
			</Grid>
		</Border>

		<!-- Параметры -->
		<Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="18"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<TextBlock Text="Параметры и действия"
                           Style="{StaticResource SectionTextStyle}"/>

				<Grid Grid.Row="2">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="160"/>
						<ColumnDefinition Width="12"/>
						<ColumnDefinition Width="160"/>
						<ColumnDefinition Width="12"/>
						<ColumnDefinition Width="140"/>
						<ColumnDefinition Width="12"/>
						<ColumnDefinition Width="140"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0">
						<Label Content="Год"/>
						<ComboBox x:Name="YearComboBox"
                                  Width="160"
                                  Height="40"
                                  Style="{StaticResource ModernComboBoxStyle}"/>
					</StackPanel>

					<StackPanel Grid.Column="2">
						<Label Content="Месяц"/>
						<ComboBox x:Name="MonthComboBox"
                                  Width="160"
                                  Height="40"
                                  Style="{StaticResource ModernComboBoxStyle}"/>
					</StackPanel>

					<Button Grid.Column="4"
                            Content="Загрузить"
                            Width="140"
                            Height="42"
                            Margin="0,30,0,0"
                            Click="LoadButton_Click"/>

					<Button Grid.Column="6"
                            Content="Сохранить"
                            Width="140"
                            Height="42"
                            Margin="0,30,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="SaveButton_Click"/>
				</Grid>
			</Grid>
		</Border>

		<!-- Таблица -->
		<Border Grid.Row="4"
                Style="{StaticResource CardBorderStyle}"
                Padding="18">
			<DataGrid x:Name="ProfoDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      FrozenColumnCount="2"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Филиал"
                                        Binding="{Binding BranchName}"
                                        Width="150"
                                        IsReadOnly="True"/>

					<DataGridTextColumn Header="Администратор"
                                        Binding="{Binding EmployeeFullName}"
                                        Width="240"
                                        IsReadOnly="True"/>

					<DataGridComboBoxColumn Header="Ставка"
                                            Width="110"
                                            SelectedItemBinding="{Binding Rate, UpdateSourceTrigger=PropertyChanged}"
                                            x:Name="RateColumn"/>

					<DataGridTextColumn Header="Пригласили"
                                        Binding="{Binding InvitedCount}"
                                        Width="120"
                                        IsReadOnly="True"/>

					<DataGridTextColumn Header="Записались"
                                        Binding="{Binding BookedCount}"
                                        Width="120"
                                        IsReadOnly="True"/>

					<DataGridTextColumn Header="Пришли"
                                        Binding="{Binding ArrivedCount}"
                                        Width="120"
                                        IsReadOnly="True"/>

					<DataGridComboBoxColumn Header="Категория"
                                            Width="200"
                                            SelectedValueBinding="{Binding ProfoCategoryId, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Id"
                                            DisplayMemberPath="Name"
                                            x:Name="CategoryColumn"/>

					<DataGridTextColumn Header="Премия"
                                        Binding="{Binding Premium}"
                                        Width="140"
                                        IsReadOnly="True"/>
				</DataGrid.Columns>
			</DataGrid>
		</Border>

		<!-- Итоги -->
		<Border Grid.Row="6"
                Style="{StaticResource CardBorderStyle}">
			<TextBlock x:Name="TotalsTextBlock"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryDarkBrush}"
                       TextWrapping="Wrap"/>
		</Border>

		<!-- Конверсия -->
		<Border Grid.Row="8"
                Style="{StaticResource CardBorderStyle}"
                Background="{StaticResource PrimaryLightBrush}"
                BorderBrush="#BFDBFE">
			<TextBlock x:Name="ConversionTextBlock"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryDarkBrush}"
                       TextWrapping="Wrap"/>
		</Border>
	</Grid>
</Window>