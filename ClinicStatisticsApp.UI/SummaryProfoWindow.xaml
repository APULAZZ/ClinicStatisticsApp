<Window x:Class="ClinicStatisticsApp.UI.SummaryProfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Статистика проф. осмотров"
        Height="900"
        Width="1480"
        MinHeight="860"
        MinWidth="1320"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Статистика проф. осмотров"
                               Style="{StaticResource TitleTextStyle}"
                               FontSize="18"/>
                    <TextBlock Text="Сводка по профосмотрам, категориям, ставкам и премии."
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,2,0,0"
                               FontSize="11"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource PrimaryLightBrush}"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,4"
                        VerticalAlignment="Top">
                    <TextBlock Text="Сводный отчет"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Label Content="Год"/>
                    <ComboBox x:Name="YearComboBox"
                              Width="130"
                              Height="30"
                              FontSize="12"
                              Style="{StaticResource ModernComboBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Label Content="Месяц"/>
                    <ComboBox x:Name="MonthComboBox"
                              Width="130"
                              Height="30"
                              FontSize="12"
                              Style="{StaticResource ModernComboBoxStyle}"/>
                </StackPanel>

                <Button Grid.Column="4"
                        Content="Загрузить"
                        Width="110"
                        Height="32"
                        Margin="0,24,0,0"
                        FontSize="12"
                        Click="LoadButton_Click"/>

                <Button Grid.Column="6"
                        Content="Сохранить"
                        Width="110"
                        Height="32"
                        Margin="0,24,0,0"
                        FontSize="12"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="SaveButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Padding="8">
            <DataGrid x:Name="ProfoDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      FrozenColumnCount="2"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      RowHeight="26"
                      ColumnHeaderHeight="37"
                      FontSize="12"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#E5E7EB"
                      VerticalGridLinesBrush="#E5E7EB">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Филиал" Binding="{Binding BranchName}" Width="140" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Администратор" Binding="{Binding EmployeeFullName}" Width="220" IsReadOnly="True"/>
                    <DataGridComboBoxColumn Header="Ставка"
                                            Width="90"
                                            SelectedItemBinding="{Binding Rate, UpdateSourceTrigger=PropertyChanged}"
                                            x:Name="RateColumn"/>
                    <DataGridTextColumn Header="Пригласили" Binding="{Binding InvitedCount}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Записались" Binding="{Binding BookedCount}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Пришли" Binding="{Binding ArrivedCount}" Width="100" IsReadOnly="True"/>
                    <DataGridComboBoxColumn Header="Категория"
                                            Width="180"
                                            SelectedValueBinding="{Binding ProfoCategoryId, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Id"
                                            DisplayMemberPath="Name"
                                            x:Name="CategoryColumn"/>
                    <DataGridTextColumn Header="Премия" Binding="{Binding Premium}" Width="110" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="6"
                Style="{StaticResource CardBorderStyle}"
                Padding="8">
            <TextBlock x:Name="TotalsTextBlock"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryDarkBrush}"
                       TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="8"
                Style="{StaticResource CardBorderStyle}"
                Padding="8"
                Background="{StaticResource PrimaryLightBrush}"
                BorderBrush="#BFDBFE">
            <TextBlock x:Name="ConversionTextBlock"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryDarkBrush}"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>