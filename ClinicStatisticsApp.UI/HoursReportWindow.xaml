<UserControl x:Class="ClinicStatisticsApp.UI.HoursReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource PageBackgroundSoftBrush}">

    <UserControl.Resources>
        <Style x:Key="CenteredCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LeftCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="← Назад"
                        Width="82"
                        Height="30"
                        Margin="0"
                        FontSize="11"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BackButton_Click"/>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Раздел ЧАСЫ"
                               Style="{StaticResource TitleTextStyle}"
                               FontSize="18"/>

                    <TextBlock Text="Отработанные часы по сотрудникам"
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,2,0,0"
                               FontSize="11"/>
                </StackPanel>

                <Border Grid.Column="3"
                        Background="{StaticResource PrimaryLightBrush}"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,4"
                        VerticalAlignment="Top">
                    <TextBlock Text="Редактирование"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- Период и действия -->
        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="118"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="118"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Label Content="Год"/>
                    <ComboBox x:Name="YearComboBox"
                              Width="118"
                              Height="30"
                              FontSize="12"
                              Style="{StaticResource ModernComboBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Label Content="Месяц"/>
                    <ComboBox x:Name="MonthComboBox"
                              Width="118"
                              Height="30"
                              FontSize="12"
                              Style="{StaticResource ModernComboBoxStyle}"/>
                </StackPanel>

                <Button Grid.Column="4"
                        Content="Открыть"
                        Width="90"
                        Height="32"
                        Margin="0,24,0,0"
                        FontSize="12"
                        Click="OpenButton_Click"/>

                <Button Grid.Column="6"
                        Content="Сохранить"
                        Width="90"
                        Height="32"
                        Margin="0,24,0,0"
                        FontSize="12"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="SaveButton_Click"/>

                <Button Grid.Column="8"
                        Content="Скопировать"
                        Width="120"
                        Height="32"
                        Margin="0,24,0,0"
                        FontSize="12"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CopyFromPreviousButton_Click"/>

                <Button Grid.Column="10"
                        Content="Добавить"
                        Width="95"
                        Height="32"
                        Margin="0,24,0,0"
                        FontSize="12"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="AddRowButton_Click"/>

                <Button Grid.Column="12"
                        Content="Удалить"
                        Width="95"
                        Height="32"
                        Margin="0,24,0,0"
                        FontSize="12"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="DeleteRowButton_Click"/>
            </Grid>
        </Border>

        <!-- Таблица -->
        <Border Grid.Row="4"
                Style="{StaticResource CardBorderStyle}"
                Padding="8">
            <DataGrid x:Name="HoursDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CellEditEnding="HoursDataGrid_CellEditEnding"
                      CurrentCellChanged="HoursDataGrid_CurrentCellChanged"
                      RowHeight="26"
                      ColumnHeaderHeight="30"
                      FontSize="12"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#E5E7EB"
                      VerticalGridLinesBrush="#E5E7EB">
                <DataGrid.Resources>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="6,2"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>

                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Height" Value="30"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="BorderBrush" Value="#D1D5DB"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Сотрудник" Width="340">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding EmployeeFullName}"
                                           Style="{StaticResource LeftCellStyle}"
                                           FontSize="12"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Employees, RelativeSource={RelativeSource AncestorType=Window}}"
                                          DisplayMemberPath="FullName"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding EmployeeId, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          Height="26"
                                          FontSize="12"
                                          Margin="0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Отработанные часы"
                                        Width="130"
                                        Binding="{Binding WorkedHours, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource CenteredCellStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Итоги -->
        <Border Grid.Row="6"
                Style="{StaticResource CardBorderStyle}"
                Padding="8">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="1"
                           Text="Итого часов:"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock x:Name="HoursTotalTextBlock"
                           Grid.Column="2"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource PrimaryDarkBrush}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
