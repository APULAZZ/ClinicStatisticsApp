<UserControl x:Class="ClinicStatisticsApp.UI.Views.CrmAnalyticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Padding="12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
            <WrapPanel>
                <TextBlock Text="Период:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="SourceComboBox" Width="220" Margin="0,0,12,0" DisplayMemberPath="Name"/>
                <DatePicker x:Name="FromDatePicker" Width="125"/>
                <TextBlock Text="—" VerticalAlignment="Center" Margin="8,0"/>
                <DatePicker x:Name="ToDatePicker" Width="125"/>
                <Button x:Name="ImportButton" Content="Обновить данные из Firebird" Margin="14,0,0,0" Padding="12,6" Click="ImportButton_Click"/>
                <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#475569" TextWrapping="Wrap"/>
            </WrapPanel>
        </Border>
        <TabControl x:Name="AnalyticsTabs" Grid.Row="1" Margin="0,14,0,0">
            <TabItem Header="Воронка">
                <StackPanel Margin="20">
                    <TextBlock Text="Воронка пациентов" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#475569" Text="Этапы первичного пациента, конверсия между этапами, среднее время на этапе и список зависших пациентов. История этапов будет храниться в CRM-базе."/>
                    <Border Margin="0,18,0,0" Padding="16" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6"><TextBlock x:Name="FunnelSummaryTextBlock" FontSize="16" TextWrapping="Wrap"/></Border>
                </StackPanel>
            </TabItem>
            <TabItem Header="Записи">
                <StackPanel Margin="20">
                    <TextBlock Text="Записи и загрузка" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#475569" Text="Новые и повторные пациенты, подтверждения, отмены, неявки, загрузка врачей и кабинетов. Данные берутся только для чтения из подключённых источников."/>
                    <Border Margin="0,18,0,0" Padding="16" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6"><TextBlock x:Name="AppointmentsSummaryTextBlock" FontSize="16" TextWrapping="Wrap"/></Border>
                </StackPanel>
            </TabItem>
            <TabItem Header="Финансы">
                <StackPanel Margin="20">
                    <TextBlock Text="Финансы" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#475569" Text="Начислено, оплачено, средний чек и выручка по филиалам, врачам, услугам, первичным и повторным пациентам."/>
                    <Border Margin="0,18,0,0" Padding="16" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6"><TextBlock x:Name="FinanceSummaryTextBlock" FontSize="16" TextWrapping="Wrap"/></Border>
                </StackPanel>
            </TabItem>
            <TabItem Header="Удержание">
                <StackPanel Margin="20">
                    <TextBlock Text="Удержание пациентов" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#475569" Text="Очереди пациентов без следующей записи, с просроченным контрольным визитом и с незавершённым планом лечения. В дальнейшем — задачи и напоминания из CRM."/>
                    <Border Margin="0,18,0,0" Padding="16" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6"><TextBlock x:Name="RetentionSummaryTextBlock" FontSize="16" TextWrapping="Wrap"/></Border>
                </StackPanel>
            </TabItem>
            <TabItem Header="Первичные">
                <Grid Margin="20">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Первичные пациенты и приход к врачам" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#475569" Text="ПерК — первый визит в клинику; ПерВ — первый визит к врачу. Показатели считаются только за выбранный период."/>
                    </StackPanel>
                    <Border Grid.Row="1" Margin="0,18,0,14" Padding="14" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6"><TextBlock x:Name="PrimarySummaryTextBlock" FontSize="16" TextWrapping="Wrap"/></Border>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
                        <Grid Margin="0,0,12,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="Врачи" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                            <DataGrid Grid.Row="1" x:Name="PrimaryDoctorsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Врач" Binding="{Binding DoctorName}" Width="*"/>
                                    <DataGridTextColumn Header="Всего" Binding="{Binding TotalPatients}" Width="55"/>
                                    <DataGridTextColumn Header="1 раз" Binding="{Binding OneVisitPatients}" Width="55"/>
                                    <DataGridTextColumn Header="2 раза" Binding="{Binding TwoVisitPatients}" Width="55"/>
                                    <DataGridTextColumn Header="&gt;3" Binding="{Binding ThreeOrMoreVisitPatients}" Width="55"/>
                                    <DataGridTextColumn Header="Среднее" Binding="{Binding AverageVisits, StringFormat={}{0:N2}}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="Пациенты" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                            <DataGrid Grid.Row="1" x:Name="PrimaryPatientsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Пациент" Binding="{Binding PatientName}" Width="*"/>
                                    <DataGridTextColumn Header="№ карты" Binding="{Binding CardNumber}" Width="85"/>
                                    <DataGridTextColumn Header="Тип" Binding="{Binding PrimaryType}" Width="55"/>
                                    <DataGridTextColumn Header="Врач" Binding="{Binding DoctorName}" Width="140"/>
                                    <DataGridTextColumn Header="Дата" Binding="{Binding FirstAppointmentDate, StringFormat={}{0:dd.MM.yyyy}}" Width="90"/>
                                    <DataGridTextColumn Header="Визитов" Binding="{Binding VisitCount}" Width="65"/>
                                    <DataGridTextColumn Header="Администратор" Binding="{Binding AdministratorName}" Width="140"/>
                                    <DataGridTextColumn Header="Причина ухода" Binding="{Binding DepartureReasonName}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
