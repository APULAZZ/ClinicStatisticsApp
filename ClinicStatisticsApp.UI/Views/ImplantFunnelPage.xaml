<UserControl x:Class="ClinicStatisticsApp.UI.Views.ImplantFunnelPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,20">
            <TextBlock Text="Воронка имплантов" FontSize="25" FontWeight="SemiBold" Foreground="#172033"/>
            <TextBlock Text="Загрузите выгрузку колл-трекинга, затем обновите записи и оплаты из Firebird. Все данные хранятся в CRM; Firebird используется только для чтения." Foreground="#64748B" TextWrapping="Wrap" Margin="0,7,0,16"/>

            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16">
                <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,14,8"><TextBlock Text="С" Foreground="#64748B"/><DatePicker x:Name="FromDatePicker" Width="140"/></StackPanel>
                    <StackPanel Margin="0,0,14,8"><TextBlock Text="По" Foreground="#64748B"/><DatePicker x:Name="ToDatePicker" Width="140"/></StackPanel>
                    <Button x:Name="ShowReportButton" Content="Показать отчёт" Click="ShowReportButton_Click" Padding="16,9" Margin="0,18,10,8"/>
                    <ComboBox x:Name="ComparisonGranularityComboBox" Width="125" SelectedIndex="0" Margin="0,18,6,8"><ComboBoxItem Content="По месяцам"/><ComboBoxItem Content="По годам"/></ComboBox>
                    <Button x:Name="ComparePeriodsButton" Content="Сравнить периоды" Click="ComparePeriodsButton_Click" Padding="16,9" Margin="0,18,10,8"/>
                    <Button x:Name="ImportLeadsButton" Content="Загрузить файл заявок и звонков" Click="ImportLeadsButton_Click" Padding="16,9" Margin="0,18,10,8"/>
                    <Button x:Name="UpdateMangoButton" Content="Обновить Mango: звонки и теги" Click="UpdateMangoButton_Click" Padding="16,9" Margin="0,18,10,8"/>
                    <Button x:Name="UpdatePhonesButton" Content="Обновить карточки и телефоны" Click="UpdatePhonesButton_Click" Padding="16,9" Margin="0,18,10,8"/>
                    <Button x:Name="StopPhonesButton" Content="Остановить" Click="StopPhonesButton_Click" IsEnabled="False" Padding="16,9" Margin="0,18,10,8"/>
                    <Button x:Name="UpdateWarehouseButton" Content="Обновить MedM, записи и оплаты" Click="UpdateWarehouseButton_Click" Padding="16,9" Margin="0,18,0,8"/>
                    <TextBlock Text="Бюджет" Foreground="#64748B" Margin="18,20,6,8" VerticalAlignment="Center"/>
                    <TextBox x:Name="BudgetTextBox" Width="120" Margin="0,18,6,8" VerticalContentAlignment="Center"/>
                    <Button Content="Сохранить" Click="SaveBudgetButton_Click" Padding="12,8" Margin="0,18,0,8"/>
                </WrapPanel>
                <TextBlock x:Name="FileStatusTextBlock" Foreground="#166534" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="PhoneIndexStatusTextBlock" Foreground="#166534" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="MangoStatusTextBlock" Foreground="#166534" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="StatusTextBlock" Foreground="#64748B" Margin="0,9,0,0" TextWrapping="Wrap"/>
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                    <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="PhoneImportLogTextBlock" Foreground="#475569" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                    <ScrollViewer MaxHeight="145" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="MangoImportLogTextBlock" Foreground="#475569" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
                </StackPanel>
            </Border>

            <UniformGrid Columns="4" Margin="0,16,0,0">
                <Border Background="#EAF2FF" CornerRadius="10" Padding="16" Margin="0,0,10,0" ToolTip="Все строки из загруженного файла №1 за выбранный период."><StackPanel><TextBlock Text="Лиды" Foreground="#475569"/><TextBlock x:Name="LeadCountText" Text="—" FontSize="25" FontWeight="SemiBold" Foreground="#1D4ED8"/></StackPanel></Border>
                <Border Background="#EAFBF2" CornerRadius="10" Padding="16" Margin="0,0,10,0" ToolTip="Лиды, по которым Mango-тег говорит, что во время звонка была сделана запись."><StackPanel><TextBlock Text="Запись по Mango" Foreground="#475569"/><TextBlock x:Name="MangoBookedCountText" Text="—" FontSize="25" FontWeight="SemiBold" Foreground="#15803D"/></StackPanel></Border>
                <Border Background="#FFF7E6" CornerRadius="10" Padding="16" Margin="0,0,10,0" ToolTip="Записи, подтверждённые сопоставлением телефона, сотрудника и события «Назначен» в MedM."><StackPanel><TextBlock Text="Подтверждено в MedM" Foreground="#475569"/><TextBlock x:Name="AppointmentCountText" Text="—" FontSize="25" FontWeight="SemiBold" Foreground="#B45309"/></StackPanel></Border>
                <Border Background="#F4EEFF" CornerRadius="10" Padding="16" ToolTip="Факт прихода: в MedM есть событие «Пришёл» по записи с уже прошедшей датой."><StackPanel><TextBlock Text="Подтверждённая явка" Foreground="#475569"/><TextBlock x:Name="AttendedCountText" Text="—" FontSize="25" FontWeight="SemiBold" Foreground="#7E22CE"/></StackPanel></Border>
            </UniformGrid>

            <UniformGrid Columns="4" Margin="0,10,0,0">
                <Border Background="#F8FAFC" CornerRadius="10" Padding="14" Margin="0,0,10,0" ToolTip="Сумма оплат сопоставленных пациентов после записи в выбранном периоде."><StackPanel><TextBlock Text="Оплаты" Foreground="#475569"/><TextBlock x:Name="PaymentText" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="#7E22CE"/></StackPanel></Border>
                <Border Background="#F8FAFC" CornerRadius="10" Padding="14" Margin="0,0,10,0" ToolTip="Бюджет, делённый на число лидов."><StackPanel><TextBlock Text="Цена лида" Foreground="#475569"/><TextBlock x:Name="CostLeadText" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="#0F766E"/></StackPanel></Border>
                <Border Background="#F8FAFC" CornerRadius="10" Padding="14" Margin="0,0,10,0" ToolTip="Бюджет, делённый на число подтверждённых явок."><StackPanel><TextBlock Text="Цена явки" Foreground="#475569"/><TextBlock x:Name="CostVisitText" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="#0F766E"/></StackPanel></Border>
                <Border Background="#F8FAFC" CornerRadius="10" Padding="14" ToolTip="Выручка, делённая на рекламный бюджет. Это показатель окупаемости по выручке, без учёта себестоимости услуг."><StackPanel><TextBlock Text="Выручка / бюджет" Foreground="#475569"/><TextBlock x:Name="RevenueToBudgetText" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="#0F766E"/></StackPanel></Border>
            </UniformGrid>

            <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="Конверсионная воронка" FontSize="17" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,0,12"/>
                        <ItemsControl x:Name="StagesItemsControl"><ItemsControl.ItemTemplate><DataTemplate>
                            <StackPanel Margin="0,0,0,10"><DockPanel><TextBlock Text="{Binding Name}" Foreground="#334155"/><TextBlock Text="{Binding Value, StringFormat={}{0:N0}}" FontWeight="SemiBold" DockPanel.Dock="Right"/><TextBlock Text="{Binding ConversionText}" Foreground="#64748B" DockPanel.Dock="Right"/></DockPanel><Border Width="{Binding BarWidth}" Height="16" Background="#3B82F6" CornerRadius="5" HorizontalAlignment="Left"/></StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock x:Name="FunnelNoteText" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18">
                    <StackPanel><TextBlock Text="Пояснения к данным" FontSize="17" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,0,10"/>
                        <TextBlock Text="Карточки и все телефоны пациентов сначала копируются в SQL CRM. Звонок подтверждается событием «Назначен» в MedM: точный телефон, сопоставленный сотрудник колл-центра и создание записи в течение 7 дней. Для заявки без указанного сотрудника используется точный телефон и время." Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="«Подтверждённая явка» — только событие «Пришёл» в MedM по записи с прошедшей датой. Будущие приёмы и отсутствие отметки не считаются явкой." Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="Сумма — оплаты сопоставленного пациента после найденной записи в выбранном периоде; до появления метки «импланты» она включает все услуги пациента." Foreground="#475569" TextWrapping="Wrap"/>
                        <Separator Margin="0,10,0,8"/>
                        <TextBlock Text="Сверка Mango и MedM" FontWeight="SemiBold" Foreground="#172033"/>
                        <TextBlock x:Name="MangoReconciliationText" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Динамика по месяцам" FontSize="17" FontWeight="SemiBold" Foreground="#172033"/>
                    <TextBlock Text="Синий — лиды, зелёный — записи по тегам Mango. Наведите курсор на месяц, чтобы увидеть точные значения." Foreground="#64748B" FontSize="12" Margin="0,3,0,10"/>
                    <ItemsControl x:Name="DynamicsItemsControl">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Month}" Foreground="#475569" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1" Width="260" Height="25" HorizontalAlignment="Left">
                                    <Grid.ToolTip><ToolTip><StackPanel><TextBlock Text="{Binding Month}" FontWeight="SemiBold"/><TextBlock Text="{Binding Leads, StringFormat=Лиды: {0:N0}}"/><TextBlock Text="{Binding MangoBooked, StringFormat=Записи по Mango: {0:N0}}"/><TextBlock Text="{Binding MangoPercent, StringFormat=Доля записей Mango: {0:N1}% от лидов}"/></StackPanel></ToolTip></Grid.ToolTip>
                                    <Border Background="#F1F5F9" Height="25" CornerRadius="4"/>
                                    <StackPanel><Border Height="10" Width="{Binding LeadBarWidth}" Background="#3B82F6" CornerRadius="4" HorizontalAlignment="Left"/><Border Height="10" Width="{Binding MangoBarWidth}" Background="#22C55E" CornerRadius="4" HorizontalAlignment="Left" Margin="0,3,0,0"/></StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Сравнение периодов" FontSize="17" FontWeight="SemiBold" Foreground="#172033"/>
                    <TextBlock Text="Выберите диапазон дат и детализацию сверху, затем нажмите «Сравнить периоды». Все показатели строятся из сохранённых данных CRM." Foreground="#64748B" FontSize="12" Margin="0,3,0,10" TextWrapping="Wrap"/>
                    <ItemsControl x:Name="ComparisonFunnelsItemsControl"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Width="205" Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,0,10,10" ToolTip="Цвета: синий — лиды, зелёный — подтверждённые записи MedM, фиолетовый — явки.">
                            <StackPanel><TextBlock Text="{Binding Period}" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="{Binding Leads, StringFormat=Лиды: {0:N0}}" Foreground="#475569" Margin="0,4,0,2"/><Border Width="{Binding LeadBarWidth}" Height="9" Background="#3B82F6" CornerRadius="4" HorizontalAlignment="Left"/><TextBlock Text="{Binding MedmAppointments, StringFormat=MedM: {0:N0}}" Foreground="#475569" Margin="0,5,0,2"/><Border Width="{Binding MedmBarWidth}" Height="9" Background="#22C55E" CornerRadius="4" HorizontalAlignment="Left"/><TextBlock Text="{Binding Attended, StringFormat=Явки: {0:N0}}" Foreground="#475569" Margin="0,5,0,2"/><Border Width="{Binding VisitBarWidth}" Height="9" Background="#8B5CF6" CornerRadius="4" HorizontalAlignment="Left"/></StackPanel>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <DataGrid x:Name="ComparisonGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="125">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Период" Binding="{Binding Period}" Width="120"/>
                            <DataGridTextColumn Header="Лиды" Binding="{Binding Leads, StringFormat={}{0:N0}}" Width="80"/>
                            <DataGridTextColumn Header="Mango" Binding="{Binding MangoBooked, StringFormat={}{0:N0}}" Width="80"/>
                            <DataGridTextColumn Header="MedM" Binding="{Binding MedmAppointments, StringFormat={}{0:N0}}" Width="80"/>
                            <DataGridTextColumn Header="Явки" Binding="{Binding Attended, StringFormat={}{0:N0}}" Width="80"/>
                            <DataGridTextColumn Header="Выручка" Binding="{Binding Revenue, StringFormat={}{0:N0}}" Width="110"/>
                            <DataGridTextColumn Header="Δ лиды" Binding="{Binding LeadDeltaPercent, StringFormat={}{0:+0.0;-0.0;0}%}" Width="85"/>
                            <DataGridTextColumn Header="Δ явки" Binding="{Binding VisitDeltaPercent, StringFormat={}{0:+0.0;-0.0;0}%}" Width="85"/>
                            <DataGridTextColumn Header="Δ выручка" Binding="{Binding RevenueDeltaPercent, StringFormat={}{0:+0.0;-0.0;0}%}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,18,0,0">
                <StackPanel><TextBlock Text="Результаты по филиалам" FontSize="17" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,0,12"/>
                    <DataGrid x:Name="BranchesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" MinHeight="180">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BranchName}" Value="Всего">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Background" Value="#EAF2FF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns><DataGridTextColumn Header="Филиал" Binding="{Binding BranchName}" Width="*"/><DataGridTextColumn Header="Записи" Binding="{Binding Appointments, StringFormat={}{0:N0}}" Width="100"/><DataGridTextColumn Header="Подтверждённая явка" Binding="{Binding NotMarkedNoShow, StringFormat={}{0:N0}}" Width="180"/><DataGridTextColumn Header="Оплаты" Binding="{Binding PaymentTotal, StringFormat={}{0:N0}}" Width="130"/><DataGridTextColumn Header="Средний чек" Binding="{Binding AverageCheck, StringFormat={}{0:N0}}" Width="130"/></DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Проверка сопоставления лидов" FontSize="17" FontWeight="SemiBold" Foreground="#172033"/>
                    <TextBlock Text="Строки «Не найдена запись» помогут адресно проверить случаи, которые автоматике пока не удалось связать с MedM. Данные только для просмотра." Foreground="#64748B" FontSize="12" Margin="0,3,0,10" TextWrapping="Wrap"/>
                    <DataGrid x:Name="MatchingAuditGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Лид" Binding="{Binding LeadDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="145"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding LeadType}" Width="80"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="150"/>
                            <DataGridTextColumn Header="Сотрудник" Binding="{Binding OperatorName}" Width="150"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="230"/>
                            <DataGridTextColumn Header="Филиал" Binding="{Binding BranchName}" Width="*"/>
                            <DataGridTextColumn Header="Карта" Binding="{Binding PatientCardNumber}" Width="90"/>
                            <DataGridTextColumn Header="Приём" Binding="{Binding AppointmentDate, StringFormat={}{0:dd.MM.yyyy}}" Width="105"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
