<Window x:Class="ClinicStatisticsApp.UI.Views.CalendarEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Событие" Width="520" Height="610" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="TitleTextBox" FontSize="18" FontWeight="SemiBold" Padding="10" BorderBrush="#CBD5E1" ToolTip="Название события"/>
        <TextBox x:Name="DescriptionTextBox" Grid.Row="1" Margin="0,12,0,0" Height="76" Padding="10" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" BorderBrush="#CBD5E1" ToolTip="Описание или заметка"/>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Начало" Foreground="#475569"/><DatePicker x:Name="StartDatePicker" Margin="0,5,0,0"/><ComboBox x:Name="StartTimeComboBox" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Окончание" Foreground="#475569"/><DatePicker x:Name="EndDatePicker" Margin="0,5,0,0"/><ComboBox x:Name="EndTimeComboBox" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Grid.Column="4"><TextBlock Text="Цвет" Foreground="#475569"/><ComboBox x:Name="ColorComboBox" Margin="0,5,0,0" SelectedValuePath="Tag"><ComboBoxItem Content="Синий" Tag="#2563EB"/><ComboBoxItem Content="Фиолетовый" Tag="#7C3AED"/><ComboBoxItem Content="Зелёный" Tag="#059669"/><ComboBoxItem Content="Оранжевый" Tag="#EA580C"/></ComboBox></StackPanel>
        </Grid>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <CheckBox x:Name="AllDayCheckBox" Content="Весь день" VerticalAlignment="Center" Checked="AllDayChanged" Unchecked="AllDayChanged"/>
            <StackPanel Grid.Column="2"><TextBlock Text="Повтор" Foreground="#475569" FontSize="12"/><ComboBox x:Name="RecurrenceComboBox" SelectedValuePath="Tag" Margin="0,4,0,0"><ComboBoxItem Content="Не повторять" Tag="None"/><ComboBoxItem Content="Каждый день" Tag="Daily"/><ComboBoxItem Content="Каждую неделю" Tag="Weekly"/><ComboBoxItem Content="Каждый месяц" Tag="Monthly"/></ComboBox></StackPanel>
            <StackPanel Grid.Column="4"><TextBlock Text="Напомнить" Foreground="#475569" FontSize="12"/><ComboBox x:Name="ReminderComboBox" SelectedValuePath="Tag" Margin="0,4,0,0"><ComboBoxItem Content="Без напоминания"/><ComboBoxItem Content="За 5 минут" Tag="5"/><ComboBoxItem Content="За 15 минут" Tag="15"/><ComboBoxItem Content="За 30 минут" Tag="30"/><ComboBoxItem Content="За 1 час" Tag="60"/></ComboBox></StackPanel>
        </Grid>
        <StackPanel Grid.Row="4" Margin="0,16,0,0">
            <TextBlock Text="Участники" FontWeight="SemiBold" Foreground="#334155"/>
            <TextBlock Text="Они увидят это событие в своём календаре." Foreground="#64748B" FontSize="12" Margin="0,3,0,8"/>
            <TextBox x:Name="ParticipantsSearchTextBox" Padding="8" Margin="0,0,0,8" ToolTip="Поиск сотрудника" TextChanged="ParticipantsSearchTextBox_TextChanged"/>
            <ListBox x:Name="ParticipantsListBox" SelectionMode="Multiple" BorderBrush="#CBD5E1"/>
        </StackPanel>
        <DockPanel Grid.Row="5" Margin="0,20,0,0">
            <Button x:Name="DeleteButton" Content="Удалить" Foreground="#B91C1C" Background="Transparent" BorderBrush="#FCA5A5" Padding="15,8" Click="DeleteButton_Click" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right"><Button Content="Отмена" Padding="15,8" Margin="0,0,8,0" Click="CancelButton_Click"/><Button Content="Сохранить" Padding="18,8" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Click="SaveButton_Click"/></StackPanel>
        </DockPanel>
    </Grid>
</Window>
