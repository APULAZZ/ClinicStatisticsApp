<UserControl x:Class="ClinicStatisticsApp.UI.Views.CallCenterStatisticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Copied from EmployeeStatisticsPage.xaml in CallCenterStatisticsApp. -->
        <Style x:Key="StatsCellStyle" TargetType="DataGridCell"><Setter Property="Padding" Value="10,0"/><Setter Property="BorderBrush" Value="#D8E0EA"/><Setter Property="BorderThickness" Value="0,0,1,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style x:Key="StatsHeaderStyle" TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#C9D7EA"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="Foreground" Value="#334155"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style x:Key="StatsRowStyle" TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding IsTotal}" Value="True"><Setter Property="Background" Value="#EEF4FF"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style>
        <Style TargetType="ComboBox"><Setter Property="Height" Value="34"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#334155"/><Setter Property="BorderBrush" Value="#C9D7EA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,0"/><Setter Property="Margin" Value="0"/></Style>
        <Style TargetType="DatePicker"><Setter Property="Height" Value="34"/><Setter Property="Margin" Value="0"/></Style>
    </UserControl.Resources>
    <Grid Background="#F6F8FC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource SoftBorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleTextBlock" Style="{StaticResource TitleTextStyle}" FontSize="22"/>
                    <TextBlock x:Name="DescriptionTextBlock" Style="{StaticResource BodyTextStyle}" Margin="0,5,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <StackPanel><TextBlock Text="С" Style="{StaticResource BodyTextStyle}" FontSize="12"/><DatePicker x:Name="FromDatePicker" Width="132"/></StackPanel>
                        <StackPanel Margin="12,0,0,0"><TextBlock Text="По" Style="{StaticResource BodyTextStyle}" FontSize="12"/><DatePicker x:Name="ToDatePicker" Width="132"/></StackPanel>
                        <Button x:Name="RefreshButton" Content="Обновить" Margin="16,18,0,0" Style="{StaticResource CallCenterActionButtonStyle}" Click="RefreshButton_Click"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="StatusTextBlock" Grid.Column="1" VerticalAlignment="Bottom" Margin="16,0,0,4" Style="{StaticResource BodyTextStyle}"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="0">
            <DataGrid x:Name="StatisticsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      RowHeaderWidth="0" GridLinesVisibility="None" RowHeight="36" CellStyle="{StaticResource StatsCellStyle}" ColumnHeaderStyle="{StaticResource StatsHeaderStyle}" RowStyle="{StaticResource StatsRowStyle}" Sorting="StatisticsDataGrid_Sorting">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Сотрудник" Binding="{Binding EmployeeName}" Width="*"/>
                    <DataGridTextColumn Header="Входящие с переводами" Binding="{Binding IncomingAcceptedCount}" Width="125"/>
                    <DataGridTextColumn Header="Входящие без переводов" Binding="{Binding IncomingAcceptedWithoutTransfersCount}" Width="135"/>
                    <DataGridTextColumn Header="Исходящие" Binding="{Binding OutgoingCount}" Width="90"/>
                    <DataGridTextColumn Header="Исходящие без ответа" Binding="{Binding OutgoingNoAnswerCount}" Width="125"/>
                    <DataGridTextColumn Header="Внутренние исходящие" Binding="{Binding InternalOutgoingCount}" Width="130"/>
                    <DataGridTextColumn Header="Переводы" Binding="{Binding TransfersCount}" Width="85"/>
                    <DataGridTextColumn Header="Пропущенные" Binding="{Binding MissedCount}" Width="105"/>
                    <DataGridTextColumn Header="Тематики всего" Binding="{Binding TopicsTotalCount}" Width="110"/>
                    <DataGridTextColumn Header="Тематики без перевода" Binding="{Binding TopicsWithoutTransfersCount}" Width="135"/>
                    <DataGridTextColumn Header="Тематики в переводах" Binding="{Binding TopicsInTransfersCount}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
