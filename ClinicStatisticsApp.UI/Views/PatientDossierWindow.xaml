<Window x:Class="ClinicStatisticsApp.UI.Views.PatientDossierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Карточка пациента" Width="1100" Height="720" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#F8FAFC" Padding="16" CornerRadius="8">
            <StackPanel>
                <TextBlock x:Name="PatientNameTextBlock" FontSize="24" FontWeight="SemiBold" Foreground="#172033"/>
                <DockPanel Margin="0,6,0,0"><Button x:Name="RefreshButton" Content="Обновить из источников" DockPanel.Dock="Right" Padding="12,6" Click="RefreshButton_Click"/><TextBlock x:Name="SummaryTextBlock" Foreground="#64748B" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
                <WrapPanel Margin="0,6,0,0"><TextBlock Text="Показать: " VerticalAlignment="Center"/><ComboBox x:Name="SourceFilterComboBox" Width="260" Margin="6,0,0,0" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="SourceFilterComboBox_SelectionChanged"/></WrapPanel>
                <TextBlock x:Name="MetricsTextBlock" Margin="0,6,0,0" Foreground="#334155" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="DifferencesTextBlock" Margin="0,4,0,0" Foreground="#B45309" TextWrapping="Wrap"/>
                <TextBlock x:Name="LoadingTextBlock" Margin="0,6,0,0" Foreground="#2563EB" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed"/>
                <TextBlock x:Name="SourceStatusTextBlock" Margin="0,3,0,0" Foreground="#64748B" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <TabControl Grid.Row="1" Margin="0,16,0,0">
            <TabItem Header="Обзор"><ScrollViewer><StackPanel Margin="16"><TextBlock Text="Карты филиалов" FontWeight="SemiBold"/><DataGrid x:Name="CardsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="280" Margin="0,8,0,16"><DataGrid.Columns><DataGridTextColumn Header="Филиал" Binding="{Binding Branch.Name}" Width="180"/><DataGridTextColumn Header="№ карты" Binding="{Binding SourceCardNumber}" Width="120"/><DataGridTextColumn Header="ФИО в источнике" Binding="{Binding LastName}" Width="*"/><DataGridTextColumn Header="Дата рождения" Binding="{Binding DateOfBirth, StringFormat={}{0:dd.MM.yyyy}}" Width="130"/><DataGridTextColumn Header="Источник" Binding="{Binding ClinicDataSource.Name}" Width="220"/></DataGrid.Columns></DataGrid><TextBlock Text="CRM-коммуникации и задачи" FontWeight="SemiBold"/><ItemsControl x:Name="ActivityItems" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></TabItem>
            <TabItem Header="Анкета и контакты"><ScrollViewer><ItemsControl x:Name="ProfileItems" Margin="16"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Source}" FontWeight="SemiBold"/><TextBlock Text="{Binding Contacts}" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding Address}" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></TabItem>
            <TabItem Header="Приёмы и услуги"><DataGrid x:Name="VisitsGrid" Margin="12" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="OpenVisitDetails"><DataGrid.Columns><DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="120"/><DataGridTextColumn Header="Филиал" Binding="{Binding Branch}" Width="140"/><DataGridTextColumn Header="№ карты" Binding="{Binding Card}" Width="90"/><DataGridTextColumn Header="Сумма" Binding="{Binding Amount}" Width="100"/><DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
            <TabItem Header="Услуги"><DataGrid x:Name="ServicesGrid" Margin="12" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="120"/><DataGridTextColumn Header="Филиал" Binding="{Binding Branch}" Width="140"/><DataGridTextColumn Header="Услуга" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/><DataGridTextColumn Header="Сумма" Binding="{Binding Amount}" Width="100"/></DataGrid.Columns></DataGrid></TabItem>
            <TabItem Header="Работы"><DataGrid x:Name="WorksGrid" Margin="12" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="120"/><DataGridTextColumn Header="Филиал" Binding="{Binding Branch}" Width="140"/><DataGridTextColumn Header="Описание работы" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Зуб" Binding="{Binding Tooth}" Width="70"/><DataGridTextColumn Header="Итог" Binding="{Binding Total}" Width="100"/></DataGrid.Columns></DataGrid></TabItem>
            <TabItem Header="Финансы"><DataGrid x:Name="PaymentsGrid" Margin="12" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="120"/><DataGridTextColumn Header="Филиал" Binding="{Binding Branch}" Width="140"/><DataGridTextColumn Header="Сумма" Binding="{Binding Amount}" Width="100"/><DataGridTextColumn Header="Назначение" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Касса" Binding="{Binding Cashbox}" Width="100"/></DataGrid.Columns></DataGrid></TabItem>
            <TabItem Header="Записи"><DataGrid x:Name="AppointmentsGrid" Margin="12" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="120"/><DataGridTextColumn Header="Время" Binding="{Binding Time}" Width="80"/><DataGridTextColumn Header="Филиал" Binding="{Binding Branch}" Width="140"/><DataGridTextColumn Header="Врач" Binding="{Binding Doctor}" Width="120"/><DataGridTextColumn Header="Кабинет" Binding="{Binding Room}" Width="80"/><DataGridTextColumn Header="Информация" Binding="{Binding Info}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
            <TabItem Header="Записи"><TextBlock Text="Расписание и записи будут отображаться с обязательной привязкой к филиалу." Margin="16" TextWrapping="Wrap"/></TabItem>
            <TabItem Header="CRM-журнал">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="JournalGrid" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="JournalGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="145"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="125"/>
                            <DataGridTextColumn Header="Содержание" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="Автор / источник" Binding="{Binding Source}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" Margin="0,12,0,0" Padding="10" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                        <DockPanel>
                            <Button Content="Добавить заметку" DockPanel.Dock="Right" Padding="12,6" Margin="10,0,0,0" Click="AddNoteButton_Click"/>
                            <TextBox x:Name="NewNoteTextBox" MinHeight="54" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="Внутренняя заметка CRM. В Firebird не передаётся."/>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
