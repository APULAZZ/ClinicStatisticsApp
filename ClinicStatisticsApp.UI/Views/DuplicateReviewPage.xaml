<UserControl x:Class="ClinicStatisticsApp.UI.Views.DuplicateReviewPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
      <DockPanel>
        <Button Content="Обновить" DockPanel.Dock="Right" Padding="14,7" Click="RefreshButton_Click"/>
        <StackPanel>
          <TextBlock Text="Проверка совпадений пациентов" FontSize="22" FontWeight="SemiBold" Foreground="#172033"/>
          <TextBlock Text="Одна строка — один предполагаемый пациент со всеми найденными картами в разных филиалах. Связь создаётся только после ручного подтверждения." Foreground="#64748B" Margin="0,5,0,6"/>
          <TextBox x:Name="QueryTextBox" Width="460" Height="30" HorizontalAlignment="Left" VerticalContentAlignment="Center" ToolTip="Введите номер карты, фамилию, имя или несколько слов; затем нажмите «Обновить»" KeyDown="QueryTextBox_KeyDown"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DataGrid x:Name="CandidatesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Пациент" Binding="{Binding PatientName}" Width="*"/>
          <DataGridTextColumn Header="№ карты" Binding="{Binding CardNumber}" Width="130"/>
          <DataGridTextColumn Header="Карт" Binding="{Binding CardCount}" Width="70"/>
          <DataGridTextColumn Header="Филиалы с совпадающими картами" Binding="{Binding Branches}" Width="2*"/>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock x:Name="EmptyTextBlock" Grid.Row="0" Text="Совпадений по номеру карты и ФИО между разными рабочими базами пока нет." TextWrapping="Wrap" TextAlignment="Center" Foreground="#64748B" FontSize="15" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
      <WrapPanel Grid.Row="1" Margin="0,14,0,0">
        <Button Content="Это один пациент: создать единую CRM-карточку" Padding="14,7" Margin="0,0,10,0" Click="AcceptButton_Click"/>
        <Button Content="Это разные люди" Padding="14,7" Click="RejectButton_Click"/>
      </WrapPanel>
    </Grid>
  </Grid>
</UserControl>
