<UserControl x:Class="ClinicStatisticsApp.UI.Views.ChatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="#F6F8FC">
    <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <Border Background="#202124" Padding="12,18,10,12">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="52"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="Чаты" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="8,0"/>
          <Button x:Name="CreateGroupButton" Grid.Column="1" Content="+" Width="32" Height="28" FontSize="16" Foreground="White" Background="Transparent" BorderBrush="Transparent" Visibility="Collapsed" ToolTip="Новая группа" Click="CreateGroupButton_Click"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,10,0,8">
          <TextBox x:Name="UserSearchTextBox" Height="34" Padding="28,0,10,0" VerticalContentAlignment="Center" Background="#303134" Foreground="White" BorderBrush="#4C8BF5" TextChanged="UserSearchTextBox_TextChanged" GotFocus="UserSearchTextBox_GotFocus"/>
          <TextBlock Text="⌕" FontSize="18" Foreground="#9AA0A6" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
        <Border Grid.Row="2" x:Name="SearchResultsBorder" Visibility="Collapsed" MinHeight="42" MaxHeight="280" Background="#303134" BorderBrush="#4B4D51" BorderThickness="1" CornerRadius="5" Margin="0,0,0,5">
          <Grid>
            <TextBlock x:Name="SearchHintTextBlock" Foreground="#B8BDC5" Margin="10,8" VerticalAlignment="Center" Visibility="Collapsed" TextWrapping="Wrap"/>
            <ListBox x:Name="SearchResultsListBox" Background="Transparent" BorderThickness="0" Foreground="White" DisplayMemberPath="DisplayName" SelectionChanged="SearchResultsListBox_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
          </Grid>
        </Border>
        <TextBlock Grid.Row="3" Text="Недавние чаты" Foreground="#9AA0A6" FontSize="12" Margin="8,6,0,8"/>
        <ListBox Grid.Row="4" x:Name="ConversationsListBox" Background="Transparent" BorderThickness="0" Foreground="White" SelectionChanged="ConversationsListBox_SelectionChanged">
          <ListBox.ItemTemplate><DataTemplate><Grid Margin="6,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis"/><Border Grid.Column="1" Background="#4C8BF5" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" VerticalAlignment="Center" Visibility="{Binding UnreadVisibility}"><TextBlock Text="{Binding UnreadCount}" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Border Grid.Column="1" Background="#FFFFFF" Padding="22">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ChatTitleTextBlock" Text="Выберите чат" FontSize="20" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,0,14"/><Button x:Name="ManageGroupButton" Grid.Column="1" Content="Участники" Height="30" Margin="12,0,0,8" Visibility="Collapsed" Click="ManageGroupButton_Click"/></Grid>
        <Border Grid.Row="1" Background="#E2E8F0"/>
        <ListBox x:Name="MessagesListBox" Grid.Row="2" Margin="0,16" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate><DataTemplate><Border HorizontalAlignment="{Binding BubbleAlignment}" Background="{Binding BubbleBackground}" BorderBrush="#D8E0EB" BorderThickness="1" CornerRadius="10" Padding="11,8" Margin="0,4" MaxWidth="560"><StackPanel><TextBlock Text="{Binding SenderCaption}" FontWeight="SemiBold" Foreground="{Binding SenderColor}" FontSize="12"/><TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#172033" Margin="0,3,0,0"/><ItemsControl ItemsSource="{Binding Attachments}" Margin="0,6,0,0"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding DisplayName}" Tag="{Binding Id}" Click="AttachmentButton_Click" HorizontalAlignment="Left" Background="Transparent" BorderBrush="Transparent" Foreground="#2563EB" Padding="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding TimestampText}" FontSize="10" Foreground="#7B8794" HorizontalAlignment="Right"/><Button Grid.Column="1" Content="Удалить" Tag="{Binding Id}" Click="DeleteMessageButton_Click" Visibility="{Binding DeleteVisibility}" FontSize="10" Margin="9,0,0,0" Padding="3,0" Background="Transparent" Foreground="#B42318" BorderBrush="Transparent"/></Grid></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="3" x:Name="PendingAttachmentsTextBlock" Foreground="#52606D" Margin="0,0,0,6" TextWrapping="Wrap"/>
        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="MessageTextBox" Height="38" Padding="10,0" VerticalContentAlignment="Center" IsEnabled="False" KeyDown="MessageTextBox_KeyDown" PreviewKeyDown="MessageTextBox_PreviewKeyDown"/>
          <Button x:Name="AddAttachmentButton" Grid.Column="2" Content="Вложение" Height="38" Width="95" IsEnabled="False" Click="AddAttachmentButton_Click"/>
          <Button x:Name="SendButton" Grid.Column="4" Content="Отправить" Height="38" Width="100" IsEnabled="False" Click="SendButton_Click"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
