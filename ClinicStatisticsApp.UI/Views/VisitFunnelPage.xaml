<UserControl x:Class="ClinicStatisticsApp.UI.Views.VisitFunnelPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xml:lang="ru-RU" Language="ru-RU">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14"><TextBlock Text="Воронка посещений" FontSize="25" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="Рабочие филиалы · зелёный — выше соответствующего периода прошлого года, красный — ниже." Foreground="#64748B" Margin="0,5,0,14"/><WrapPanel><TextBlock Text="Период:" VerticalAlignment="Center" Margin="0,0,7,0"/><DatePicker x:Name="FromDatePicker" Width="130"/><TextBlock Text="—" VerticalAlignment="Center" Margin="8,0"/><DatePicker x:Name="ToDatePicker" Width="130"/><Button x:Name="RefreshButton" Content="Обновить рабочие базы" Click="RefreshButton_Click" Margin="16,0,0,0" Padding="14,7"/><Button Content="Показать отчёт" Click="ShowButton_Click" Margin="8,0,0,0" Padding="14,7"/></WrapPanel><TextBlock x:Name="StatusTextBlock" Foreground="#475569" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel>
  <TabControl x:Name="ReportTabs" Grid.Row="1" SelectionChanged="ReportTabs_SelectionChanged">
   <TabItem Header="Обзор по клиникам"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="260"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,10"><TextBlock Text="Год:" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="YearComboBox" Width="100" SelectionChanged="MatrixFilterChanged"/><TextBlock Text="График для:" VerticalAlignment="Center" Margin="18,0,6,0"/><ComboBox x:Name="ChartBranchComboBox" Width="260" SelectionChanged="ChartBranchChanged"/></WrapPanel><Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12"><Grid><TextBlock x:Name="ChartTitleText" FontWeight="SemiBold" Foreground="#172033"/><Canvas x:Name="TrendCanvas" Margin="0,28,0,0" SizeChanged="TrendCanvas_SizeChanged"/><TextBlock Text="Синий — пациенты · зелёный — посещения · оранжевый — коэффициент (правая шкала)" VerticalAlignment="Bottom" Foreground="#64748B" FontSize="11"/></Grid></Border><DataGrid x:Name="MatrixGrid" Grid.Row="2" Margin="0,12,0,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0" HorizontalScrollBarVisibility="Auto"/></Grid></TabItem>
   <TabItem Header="Подробно по месяцам"><DataGrid x:Name="MonthlyGrid" Margin="8" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Клиника" Binding="{Binding Branch}" Width="*"/><DataGridTextColumn Header="Месяц" Binding="{Binding Month, StringFormat={}{0:MMMM yyyy}}" Width="140"/><DataGridTextColumn Header="Пациенты" Binding="{Binding Patients, StringFormat={}{0:N0}}" Width="100"/><DataGridTextColumn Header="Посещения" Binding="{Binding Visits, StringFormat={}{0:N0}}" Width="105"/><DataGridTextColumn Header="Коэф." Binding="{Binding Coefficient, StringFormat={}{0:N2}}" Width="80"/><DataGridTextColumn Header="Δ посещений к прошлому году" Binding="{Binding VisitsYearOverYear, StringFormat={}{0:+0;-0;0}}" Width="170"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Рабочие итоги по специалистам"><DataGrid x:Name="SpecialistsGrid" Margin="8" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><DataGrid.Columns><DataGridTextColumn Header="Специалист" Binding="{Binding Specialist}" Width="*"/><DataGridTextColumn Header="Пациенты" Binding="{Binding Patients}" Width="100"/><DataGridTextColumn Header="Записи" Binding="{Binding Visits}" Width="100"/><DataGridTextColumn Header="Неявки" Binding="{Binding NoShows}" Width="100"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Снялись с приёма"><DataGrid x:Name="CancellationsGrid" Margin="8" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><DataGrid.Columns><DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="110"/><DataGridTextColumn Header="Пациент (ID)" Binding="{Binding PatientId}" Width="120"/><DataGridTextColumn Header="Врач" Binding="{Binding Doctor}" Width="*"/><DataGridTextColumn Header="Администратор" Binding="{Binding Administrator}" Width="*"/><DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="170"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Проверка карт"><DataGrid x:Name="ChecksGrid" Margin="8" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><DataGrid.Columns><DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="110"/><DataGridTextColumn Header="Пациент (ID)" Binding="{Binding PatientId}" Width="120"/><DataGridTextColumn Header="Врач" Binding="{Binding Doctor}" Width="*"/><DataGridTextColumn Header="Администратор" Binding="{Binding Administrator}" Width="*"/><DataGridTextColumn Header="Состояние" Binding="{Binding Status}" Width="140"/></DataGrid.Columns></DataGrid></TabItem>
  </TabControl>
 </Grid>
</UserControl>
