<Window x:Class="ClinicStatisticsApp.UI.Views.CrmProfileMergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Объединение CRM-карточек" Width="820" Height="540" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Объединение CRM-карточек" FontSize="22" FontWeight="SemiBold" Foreground="#172033"/>
            <TextBlock Text="Отметьте карточки, которые нужно перенести, и выберите карточку, которая останется основной. Объединяются только CRM-карточки с одинаковыми фамилией и именем. Данные в Firebird не изменяются." Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,14"/>
        </StackPanel>
        <DataGrid x:Name="ProfilesGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" Margin="0,0,0,14">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Объединить" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="95"/>
                <DataGridTextColumn Header="№ карты" Binding="{Binding Profile.CardNumber}" Width="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="Пациент" Binding="{Binding Profile.FullName}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Дата рождения" Binding="{Binding Profile.DateOfBirth, StringFormat={}{0:dd.MM.yyyy}}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Profile.DisplayName}" Width="220" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Оставить основной:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <ComboBox x:Name="TargetComboBox" Grid.Column="2" DisplayMemberPath="DisplayName" SelectedValuePath="PersonId" Height="32"/>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Width="110" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Объединить выбранные карточки" Width="240" IsDefault="True" Click="MergeButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
