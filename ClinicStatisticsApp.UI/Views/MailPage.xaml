<UserControl x:Class="ClinicStatisticsApp.UI.Views.MailPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2563EB"/><Setter Property="Padding" Value="14,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="TextButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="#334155"/><Setter Property="Padding" Value="9,7"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EFF6FF"/></Trigger></Style.Triggers></Style>
    <HierarchicalDataTemplate x:Key="FolderTemplate" ItemsSource="{Binding Children}"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/></HierarchicalDataTemplate>
    <Style x:Key="FolderTreeItem" TargetType="TreeViewItem"><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem"><StackPanel><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter ContentTemplate="{TemplateBinding HeaderTemplate}" Content="{TemplateBinding Header}"/></Border><ItemsPresenter Margin="20,0,0,0"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#5A5A5A"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#3B3B3B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="440"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#232323" BorderBrush="#353535" BorderThickness="0,0,1,0" Padding="14"><DockPanel><Button DockPanel.Dock="Top" Content="✉  Написать письмо" Style="{StaticResource PrimaryButton}" Click="ComposeButton_Click" Margin="0,0,0,18"/><StackPanel><TextBlock Text="ПАПКИ" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="10,0,0,6"/><TreeView x:Name="FoldersTreeView" Background="Transparent" BorderThickness="0" Foreground="White" ItemTemplate="{StaticResource FolderTemplate}" ItemContainerStyle="{StaticResource FolderTreeItem}" SelectedItemChanged="FoldersTreeView_SelectedItemChanged"/></StackPanel></DockPanel></Border>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="18,12"><DockPanel><TextBlock x:Name="FolderTitleTextBlock" Text="Почта" FontSize="18" FontWeight="SemiBold" Foreground="#172033" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="CacheStatusTextBlock" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/><Button Content="Обновить" Style="{StaticResource TextButton}" Click="RefreshButton_Click"/></StackPanel></DockPanel></Border>
      <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10"><StackPanel><TextBox x:Name="SearchTextBox" Padding="8" BorderBrush="#CBD5E1" ToolTip="Поиск в текущей папке" TextChanged="SearchTextBox_TextChanged"/><WrapPanel Margin="0,8,0,0"><Button Content="Прочитано" Style="{StaticResource TextButton}" Click="MarkReadButton_Click"/><Button Content="Не прочитано" Style="{StaticResource TextButton}" Click="MarkUnreadButton_Click"/><Button Content="В папку" Style="{StaticResource TextButton}" Click="MoveButton_Click"/><Button Content="Спам" Style="{StaticResource TextButton}" Click="SpamButton_Click"/><Button Content="Удалить" Style="{StaticResource TextButton}" Click="DeleteButton_Click"/></WrapPanel></StackPanel></Border>
      <ListBox x:Name="MessagesListBox" Grid.Row="2" BorderThickness="0" SelectionMode="Extended" SelectionChanged="MessagesListBox_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Sender}" FontWeight="SemiBold" Foreground="#172033" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subject}" Foreground="#334155" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Date, StringFormat={}{0:dd.MM HH:mm}}" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid>
    <Grid Grid.Column="2" Background="White">
      <Grid x:Name="WelcomePanel" Margin="38"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Почта" FontSize="24" FontWeight="SemiBold" Foreground="#172033" HorizontalAlignment="Center"/><TextBlock x:Name="WelcomeTextBlock" Text="Выберите письмо или создайте новое." Foreground="#64748B" Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel></Grid>
      <Grid x:Name="MessagePanel" Visibility="Collapsed" Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Ответить" Style="{StaticResource TextButton}" Click="ReplyButton_Click"/><Button Content="Переслать" Style="{StaticResource TextButton}" Click="ForwardButton_Click"/><Button Content="В папку" Style="{StaticResource TextButton}" Click="MoveButton_Click"/><Button Content="Удалить" Style="{StaticResource TextButton}" Click="DeleteButton_Click"/></StackPanel><TextBlock x:Name="MessageSubjectTextBlock" Grid.Row="1" FontSize="23" FontWeight="SemiBold" Foreground="#172033" TextWrapping="Wrap"/><StackPanel Grid.Row="2" Margin="0,18,0,18"><TextBlock x:Name="MessageFromTextBlock" Foreground="#334155"/><TextBlock x:Name="MessageDateTextBlock" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/></StackPanel><Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel x:Name="AttachmentsPanel" Visibility="Collapsed" Margin="0,0,0,14"><TextBlock Text="Вложения" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/><StackPanel x:Name="AttachmentsListPanel" Orientation="Horizontal"/></StackPanel><ScrollViewer Grid.Row="1"><TextBlock x:Name="MessageBodyTextBlock" Foreground="#334155" TextWrapping="Wrap" FontSize="14" LineHeight="22"/></ScrollViewer></Grid></Grid>
      <Grid x:Name="ComposePanel" Visibility="Collapsed" Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="ComposeTitleTextBlock" Text="Новое письмо" FontSize="23" FontWeight="SemiBold" Foreground="#172033"/><TextBox x:Name="RecipientsTextBox" Grid.Row="1" Margin="0,20,0,8" Padding="10" BorderBrush="#CBD5E1" ToolTip="Кому"/><TextBox x:Name="SubjectTextBox" Grid.Row="2" Margin="0,0,0,8" Padding="10" BorderBrush="#CBD5E1" ToolTip="Тема"/><StackPanel Grid.Row="3" Orientation="Horizontal"><Button Content="Прикрепить файл" Style="{StaticResource TextButton}" Click="AttachFileButton_Click"/><TextBlock x:Name="AttachedFilesTextBlock" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><TextBox x:Name="BodyTextBox" Grid.Row="4" Margin="0,12,0,14" Padding="10" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderBrush="#CBD5E1"/><StackPanel Grid.Row="5" Orientation="Horizontal"><Button Content="Отправить" Style="{StaticResource PrimaryButton}" Click="SendButton_Click"/><Button Content="Отмена" Style="{StaticResource TextButton}" Margin="10,0,0,0" Click="CancelComposeButton_Click"/></StackPanel></Grid>
    </Grid>
  </Grid>
</UserControl>
