<UserControl x:Class="ClinicStatisticsApp.UI.Views.TasksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button"><Setter Property="Padding" Value="13,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="Foreground" Value="#334155"/></Style>
    </UserControl.Resources>
    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="+ Новая задача" Style="{StaticResource ToolbarButton}" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Click="CreateButton_Click"/>
                    <Button Content="Обновить" Style="{StaticResource ToolbarButton}" Click="RefreshButton_Click"/>
                    <Button x:Name="NotificationsButton" Content="Уведомления" Style="{StaticResource ToolbarButton}" Click="NotificationsButton_Click"/>
                    <TextBlock x:Name="AccessTextBlock" VerticalAlignment="Center" Foreground="#64748B" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Статус:" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,8,0"/>
                    <ComboBox x:Name="StatusFilterComboBox" Width="150" SelectionChanged="StatusFilterComboBox_SelectionChanged" SelectedIndex="0">
                        <ComboBoxItem Content="Все" Tag="All"/><ComboBoxItem Content="Новые" Tag="New"/><ComboBoxItem Content="В работе" Tag="InProgress"/><ComboBoxItem Content="На паузе" Tag="Paused"/><ComboBoxItem Content="На проверке" Tag="Review"/><ComboBoxItem Content="Готово" Tag="Done"/><ComboBoxItem Content="Просрочены" Tag="Overdue"/>
                    </ComboBox>
                    <ComboBox x:Name="ScopeFilterComboBox" Width="145" Margin="10,0,0,0" SelectionChanged="ScopeFilterComboBox_SelectionChanged" SelectedIndex="0">
                        <ComboBoxItem Content="Все доступные" Tag="All"/><ComboBoxItem Content="Поставленные мной" Tag="Created"/><ComboBoxItem Content="Назначенные мне" Tag="Responsible"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="BoardGrid" Margin="24"/>
        </ScrollViewer>
    </Grid>
</UserControl>
