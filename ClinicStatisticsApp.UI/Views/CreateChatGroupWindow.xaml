<Window x:Class="ClinicStatisticsApp.UI.Views.CreateChatGroupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Новая группа" Width="420" Height="500" WindowStartupLocation="CenterOwner" Background="#F6F8FC">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Название группы" Foreground="#64748B"/>
  <TextBox x:Name="TitleTextBox" Grid.Row="1" Margin="0,6,0,14" Height="34" Padding="8,0" VerticalContentAlignment="Center"/>
  <ListBox x:Name="UsersListBox" Grid.Row="2" SelectionMode="Multiple" DisplayMemberPath="DisplayName"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Отмена" Width="90" Height="32" Margin="0,0,8,0" IsCancel="True"/><Button Content="Создать" Width="90" Height="32" IsDefault="True" Click="CreateButton_Click"/></StackPanel>
 </Grid>
</Window>
