<Window x:Class="ClinicStatisticsApp.UI.Views.ManageChatGroupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Управление группой" Width="430" Height="540" WindowStartupLocation="CenterOwner" Background="#F6F8FC">
  <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Название группы" Foreground="#52606D"/>
    <TextBox x:Name="TitleTextBox" Grid.Row="1" Margin="0,6,0,14" Height="34" Padding="8,0" VerticalContentAlignment="Center"/>
    <TextBlock Grid.Row="2" Text="Участники" Foreground="#52606D" Margin="0,0,0,6"/>
    <ListBox x:Name="UsersListBox" Grid.Row="3" SelectionMode="Multiple" DisplayMemberPath="DisplayName"/>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Отмена" Width="90" Height="32" Margin="0,0,8,0" IsCancel="True"/><Button Content="Сохранить" Width="90" Height="32" IsDefault="True" Click="SaveButton_Click"/></StackPanel>
  </Grid>
</Window>
