<UserControl x:Class="ClinicStatisticsApp.UI.Views.CallCenterJournalPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <!-- В исходном CallCenterStatisticsApp используются системные WPF-шаблоны. -->
    <Style TargetType="Button"/>
    <Style TargetType="CheckBox"/>
    <Style TargetType="ComboBox"><Setter Property="Height" Value="34"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#334155"/><Setter Property="BorderBrush" Value="#C9D7EA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,0"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0"/></Style>
    <Style TargetType="TextBox"><Setter Property="Height" Value="34"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#334155"/><Setter Property="BorderBrush" Value="#C9D7EA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,0"/><Setter Property="Margin" Value="0"/></Style>
    <Style TargetType="DatePicker"><Setter Property="Height" Value="34"/><Setter Property="Margin" Value="0"/></Style>
    <Style x:Key="JournalCellStyle" TargetType="DataGridCell"><Setter Property="Padding" Value="0"/><Setter Property="BorderBrush" Value="#D8E0EA"/><Setter Property="BorderThickness" Value="0,0,1,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style x:Key="JournalHeaderStyle" TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="10,0"/><Setter Property="BorderBrush" Value="#C9D7EA"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="Foreground" Value="#334155"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </UserControl.Resources>
  <Grid Background="#F6F8FC"><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Период" Foreground="#64748B" FontSize="12" Margin="0,0,0,5"/><ComboBox x:Name="PeriodComboBox" Height="34" SelectedValuePath="Tag" SelectionChanged="QuickPeriodChanged"><ComboBoxItem Content="Сегодня" Tag="Today"/><ComboBoxItem Content="Вчера" Tag="Yesterday"/><ComboBoxItem Content="Последние 7 дней" Tag="SevenDays"/><ComboBoxItem Content="Текущая неделя" Tag="Week"/><ComboBoxItem Content="Текущий месяц" Tag="Month"/><ComboBoxItem Content="Последние 30 дней" Tag="ThirtyDays"/><ComboBoxItem Content="Произвольный" Tag="Custom"/></ComboBox></StackPanel>
      <StackPanel Grid.Column="2" x:Name="CustomPeriodPanel" Visibility="Collapsed"><TextBlock Text="Произвольный период" Foreground="#64748B" FontSize="12" Margin="0,0,0,5"/><StackPanel Orientation="Horizontal"><DatePicker x:Name="FromDatePicker" Width="150" Height="34" SelectedDateChanged="PeriodChanged"/><TextBlock Text="—" VerticalAlignment="Center" Margin="10,0"/><DatePicker x:Name="ToDatePicker" Width="150" Height="34" SelectedDateChanged="PeriodChanged"/></StackPanel></StackPanel>
      <TextBlock Grid.Column="2" x:Name="PeriodHintTextBlock" VerticalAlignment="Center" Foreground="#64748B" FontSize="14"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="От" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="FromTimeTextBox" Width="52" Text="00:00"/><TextBlock Text="До" Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,8,0"/><TextBox x:Name="ToTimeTextBox" Width="52" Text="23:59"/></StackPanel>
    </Grid></Border>
    <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,18"><WrapPanel VerticalAlignment="Center">
      <StackPanel Margin="0,0,12,8"><TextBlock Text="Сотрудник" Foreground="#64748B" FontSize="12"/><ComboBox x:Name="EmployeeComboBox" Width="170" Height="34" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="FilterChanged"/></StackPanel>
      <StackPanel Margin="0,0,12,8"><TextBlock Text="Группа" Foreground="#64748B" FontSize="12"/><ComboBox x:Name="GroupComboBox" Width="160" Height="34" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="FilterChanged"/></StackPanel>
      <StackPanel Margin="0,0,12,8"><TextBlock Text="Тематика" Foreground="#64748B" FontSize="12"/><ComboBox x:Name="TopicComboBox" Width="180" Height="34" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="FilterChanged"/></StackPanel>
      <StackPanel Margin="0,0,12,8"><TextBlock Text="Тип звонка" Foreground="#64748B" FontSize="12"/><ComboBox x:Name="DirectionComboBox" Width="130" Height="34" SelectedIndex="0" SelectionChanged="FilterChanged"><ComboBoxItem Content="Все"/><ComboBoxItem Content="Входящие"/><ComboBoxItem Content="Исходящие"/></ComboBox></StackPanel>
      <StackPanel Margin="0,0,12,8"><TextBlock Text="Длительность" Foreground="#64748B" FontSize="12"/><ComboBox x:Name="DurationComboBox" Width="130" Height="34" SelectedIndex="0" SelectionChanged="FilterChanged"><ComboBoxItem Content="Любая"/><ComboBoxItem Content="До минуты"/><ComboBoxItem Content="1–5 минут"/><ComboBoxItem Content="От 5 минут"/></ComboBox></StackPanel>
      <StackPanel Margin="0,0,12,8"><TextBlock Text="Поиск" Foreground="#64748B" FontSize="12"/><TextBox x:Name="SearchTextBox" Width="180" Height="34" TextChanged="SearchTextChanged"/></StackPanel>
      <Button x:Name="RefreshButton" Content="Обновить" Style="{StaticResource CallCenterActionButtonStyle}" Margin="0,17,10,8" Click="RefreshButton_Click"/><Button Content="Сбросить" Style="{StaticResource CallCenterActionButtonStyle}" Margin="0,17,10,8" Click="ResetButton_Click"/>
    </WrapPanel></Border>
    <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="StatusTextBlock" Text="Записей: 0" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0" Foreground="#334155"/><DataGrid x:Name="CallsDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="34"><DataGrid.Columns><DataGridTextColumn Header="Дата и время" Binding="{Binding CallDateTime, StringFormat=dd.MM.yyyy HH:mm}" Width="145"/><DataGridTextColumn Header="Сотрудник" Binding="{Binding EmployeeName}" Width="*"/><DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="150"/><DataGridTextColumn Header="Телефон" Binding="{Binding PhoneNumber}" Width="140"/><DataGridTextColumn Header="Тематика" Binding="{Binding TopicName}" Width="180"/><DataGridTextColumn Header="Тип" Binding="{Binding Direction}" Width="100"/><DataGridTextColumn Header="Длительность" Binding="{Binding Duration}" Width="105"/></DataGrid.Columns></DataGrid></Grid></Border>
  </Grid>
</UserControl>
