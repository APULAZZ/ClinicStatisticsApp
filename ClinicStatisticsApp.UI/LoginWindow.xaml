<Window x:Class="ClinicStatisticsApp.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему"
        Height="620"
        Width="940"
        MinHeight="620"
        MinWidth="940"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E1E">

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель -->
            <Border Background="#232323"
                    Padding="40">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <Border Background="#2E2E2E"
                                BorderBrush="#3A3A3A"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="18"
                                Margin="0,0,0,24">
                            <Image Source="pack://application:,,,/Assets/Logo.png"
                                   Height="150"
                                   Stretch="Uniform"/>
                        </Border>

                        <TextBlock Text="Единая CRM-система"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>


                        <Border Margin="0,24,0,0"
                                Padding="14"
                                Background="#2A2A2A"
                                CornerRadius="14"
                                BorderBrush="#3A3A3A"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="На данный момент платформа находится в разработке."
                                           Foreground="#BDBDBD"
                                           Margin="0"
                                           TextWrapping="Wrap"
                                           FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Правая панель -->
            <Grid Grid.Column="1"
                  Background="#1E1E1E">
                <Grid Margin="42">
                    <Border Background="#2A2A2A"
                            BorderBrush="#3A3A3A"
                            BorderThickness="1"
                            CornerRadius="18"
                            VerticalAlignment="Center"
                            Padding="28">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Вход"
                                       Foreground="White"
                                       FontSize="28"
                                       FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="2"
                                       Text="Введите логин и пароль для продолжения"
                                       Foreground="#AFAFAF"
                                       FontSize="14"/>

                            <StackPanel Grid.Row="4">
                                <TextBlock Text="Логин"
                                           Foreground="#D4D4D4"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <TextBox x:Name="LoginTextBox"
                                         Height="42"
                                         Background="#1F1F1F"
                                         Foreground="White"
                                         BorderBrush="#444444"
                                         BorderThickness="1"
                                         Padding="12,6"
                                         Margin="0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="6">
                                <TextBlock Text="Пароль"
                                           Foreground="#D4D4D4"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <PasswordBox x:Name="UserPasswordBox"
                                             Height="42"
                                             Background="#1F1F1F"
                                             Foreground="White"
                                             BorderBrush="#444444"
                                             BorderThickness="1"
                                             Padding="12,6"
                                             Margin="0"/>
                            </StackPanel>

                            <Button x:Name="LoginButton"
                                    Grid.Row="8"
                                    Content="Войти"
                                    Height="46"
                                    Margin="0"
                                    Background="#4B5563"
                                    BorderBrush="#4B5563"
                                    Foreground="White"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Click="LoginButton_Click"/>

                            <TextBlock x:Name="ErrorTextBlock"
                                       Grid.Row="10"
                                       Visibility="Collapsed"
                                       Foreground="#F87171"
                                       FontSize="13"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Подпись внизу всего окна -->
        <TextBlock Grid.Row="1"
                   Text="© разработчик: Елисеенко С. А."
                   Foreground="#7E7E7E"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,12"/>
    </Grid>
</Window>
