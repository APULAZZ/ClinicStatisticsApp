<Window x:Class="ClinicStatisticsApp.UI.DynamicsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Динамика"
        Height="1000"
        Width="1500"
        WindowStartupLocation="CenterOwner">
	<Grid Margin="15">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="15"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<StackPanel>
			<StackPanel Orientation="Horizontal">
				<TextBlock Text="Основной год:" VerticalAlignment="Center" Margin="0,0,8,0"/>
				<ComboBox x:Name="YearComboBox" Width="100" Margin="0,0,20,0"/>
				<Button Content="Построить" Width="140" Height="34" Click="BuildButton_Click"/>
			</StackPanel>

			<StackPanel Margin="0,15,0,0">
				<TextBlock Text="Годы для сравнения:" FontWeight="SemiBold" Margin="0,0,0,8"/>
				<WrapPanel x:Name="ComparisonYearsPanel"/>
			</StackPanel>
		</StackPanel>

		<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
			<StackPanel x:Name="BlocksPanel"/>
		</ScrollViewer>
	</Grid>
</Window>