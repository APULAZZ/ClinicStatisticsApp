<Window x:Class="ClinicStatisticsApp.UI.DynamicsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Динамика"
        Height="980"
        Width="1580"
        MinHeight="920"
        MinWidth="1380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackgroundSoftBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="10"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Динамика"
                               Style="{StaticResource TitleTextStyle}"
                               FontSize="18"/>
                    <TextBlock Text="Анализ динамики по филиалам, сотрудникам и сравнительным блокам."
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,2,0,0"
                               FontSize="11"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource SubtleAccentBrush}"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,4"
                        VerticalAlignment="Top">
                    <TextBlock Text="Аналитический отчет"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}"
                Padding="10"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Основной год"/>
                        <ComboBox x:Name="YearComboBox"
                                  Width="160"
                                  Height="30"
                                  FontSize="12"
                                  Style="{StaticResource ModernComboBoxStyle}"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="Построить"
                            Width="110"
                            Height="32"
                            Margin="0,24,0,0"
                            FontSize="12"
                            Click="BuildButton_Click"/>
                </Grid>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Годы для сравнения"
                               Style="{StaticResource SectionTextStyle}"
                               FontSize="15"/>

                    <Border Margin="0,6,0,0"
                            Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource SoftBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10">
                        <WrapPanel x:Name="ComparisonYearsPanel"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Style="{StaticResource CardBorderStyle}"
                Padding="8"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="BlocksPanel"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>